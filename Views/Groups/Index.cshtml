@model List<ChurchManagementMVC.Models.GroupManagement>

@{
    ViewData["Title"] = "Groups";
}

<div class="container-fluid py-4">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-people-fill me-2"></i>
                Groups
            </h2>

            <p class="text-muted mb-0">
                Manage church groups and their meeting activities.
            </p>
        </div>

        <div>
            <a asp-action="Create"
               class="btn btn-success rounded-3 px-4 shadow-sm">

                <i class="bi bi-plus-circle-fill me-2"></i>
                Add Group

            </a>
        </div>

    </div>


    <!-- ERROR MESSAGE -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show
            border-0 rounded-3 shadow-sm"
             role="alert">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- SUCCESS MESSAGE -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show
            border-0 rounded-3 shadow-sm"
             role="alert">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- GROUPS CARD -->
    <div class="card shadow-sm border-0 rounded-4">

        <!-- CARD HEADER -->
        <div class="card-header bg-white border-0 pt-4 px-4">

            <div class="d-flex align-items-center">

                <div class="bg-success bg-opacity-10
                    text-success rounded-circle
                    d-flex align-items-center
                    justify-content-center me-3"
                     style="width: 50px; height: 50px;">

                    <i class="bi bi-people-fill fs-5"></i>

                </div>

                <div>

                    <h5 class="fw-bold mb-1">
                        Church Groups
                    </h5>

                    <p class="text-muted mb-0">
                        View and manage registered church groups.
                    </p>

                </div>

            </div>

        </div>


        <!-- CARD BODY -->
        <div class="card-body p-0">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="ps-4"
                                    style="width: 70px;">
                                    #
                                </th>

                                <th>
                                    Group Name
                                </th>

                                <th>
                                    Type
                                </th>

                                <th>
                                    Meeting Activity
                                </th>

                                <th class="text-end pe-4">
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @{
                                int count = 1;
                            }

                            @foreach (var group in Model)
                            {
                                <tr>

                                    <!-- NUMBER -->
                                    <td class="ps-4 fw-semibold text-muted">
                                        @count
                                    </td>


                                    <!-- GROUP NAME -->
                                    <td>

                                        <div class="d-flex align-items-center">

                                            <div class="bg-success bg-opacity-10
                                                text-success rounded-circle
                                                d-flex align-items-center
                                                justify-content-center me-3"
                                                 style="width: 40px; height: 40px;">

                                                <i class="bi bi-people-fill"></i>

                                            </div>

                                            <div>

                                                <span class="fw-semibold">
                                                    @group.GroupName
                                                </span>

                                                @if (!string.IsNullOrWhiteSpace(group.Description))
                                                {
                                                    <div class="text-muted small">
                                                        @group.Description
                                                    </div>
                                                }

                                            </div>

                                        </div>

                                    </td>


                                    <!-- GROUP TYPE -->
                                    <td>

                                        @if (group.GroupType != null)
                                        {
                                            <span class="badge bg-success bg-opacity-10
                                                text-success rounded-pill px-3 py-2">

                                                <i class="bi bi-diagram-3-fill me-1"></i>

                                                @group.GroupType.Name

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                N/A
                                            </span>
                                        }

                                    </td>


                                    <!-- MEETING ACTIVITY -->
                                    <td>

                                        @if (group.Activity != null)
                                        {
                                            <div>

                                                <div class="fw-semibold">

                                                    <i class="bi bi-calendar-event-fill
                                                    text-success me-1"></i>

                                                    @group.Activity.Day

                                                </div>

                                                <small class="text-muted">

                                                    <i class="bi bi-clock me-1"></i>

                                                    @DateTime.Today.Add(group.Activity.StartTime).ToString("h:mm tt")
                                                    -
                                                    @DateTime.Today.Add(group.Activity.EndTime).ToString("h:mm tt")

                                                </small>

                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">

                                                <i class="bi bi-calendar-x me-1"></i>
                                                No activity

                                            </span>
                                        }

                                    </td>


                                    <!-- ACTIONS -->
                                    <td class="text-end pe-4">

                                        <div class="d-flex justify-content-end gap-2">

                                            <!-- OPEN GROUP -->
                                            <a asp-action="Manage"
                                               asp-route-id="@group.Id"
                                               class="btn btn-sm btn-success rounded-3 px-3">

                                                <i class="bi bi-box-arrow-in-right me-1"></i>
                                                Open Group

                                            </a>


                                            <!-- EDIT -->
                                            <a asp-action="Edit"
                                               asp-route-id="@group.Id"
                                               class="btn btn-sm btn-outline-success rounded-3 px-3">

                                                <i class="bi bi-pencil-square me-1"></i>
                                                Edit

                                            </a>


                                            <!-- DELETE -->
                                            @if (User.IsInRole("Admin"))
                                            {
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-danger rounded-3 px-3"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#deleteModal"
                                                        data-id="@group.Id"
                                                        data-name="@group.GroupName"
                                                        onclick="setDeleteDetails(this)">

                                                    <i class="bi bi-trash3 me-1"></i>
                                                    Delete

                                                </button>
                                            }

                                        </div>

                                    </td>

                                </tr>

                                count++;
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <!-- EMPTY STATE -->
                <div class="text-center py-5">

                    <div class="mb-3">

                        <i class="bi bi-people display-4 text-muted"></i>

                    </div>

                    <h5 class="fw-bold">
                        No Groups Found
                    </h5>

                    <p class="text-muted mb-4">
                        You have not added any church groups yet.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-success rounded-3 px-4">

                        <i class="bi bi-plus-circle-fill me-2"></i>
                        Add First Group

                    </a>

                </div>
            }

        </div>

    </div>

</div>


<!-- DELETE CONFIRMATION MODAL -->
<div class="modal fade"
     id="deleteModal"
     tabindex="-1"
     aria-labelledby="deleteModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow rounded-4">

            <!-- MODAL HEADER -->
            <div class="modal-header border-0">

                <h5 class="modal-title text-danger fw-bold"
                    id="deleteModalLabel">

                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    Delete Group

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <!-- MODAL BODY -->
            <div class="modal-body">

                <p>
                    Are you sure you want to delete this group?
                </p>

                <div class="alert alert-light border rounded-3">

                    <div class="d-flex align-items-center">

                        <div class="bg-danger bg-opacity-10
                            text-danger rounded-circle
                            d-flex align-items-center
                            justify-content-center me-3"
                             style="width: 40px; height: 40px;">

                            <i class="bi bi-people-fill"></i>

                        </div>

                        <div>

                            <strong>
                                Group:
                            </strong>

                            <div id="deleteGroupName"
                                 class="text-muted mt-1">
                            </div>

                        </div>

                    </div>

                </div>

                <p class="text-muted small mb-0">

                    <i class="bi bi-info-circle me-1"></i>

                    This action cannot be undone.

                </p>

            </div>


            <!-- MODAL FOOTER -->
            <div class="modal-footer border-0">

                <button type="button"
                        class="btn btn-outline-secondary rounded-3 px-4"
                        data-bs-dismiss="modal">

                    <i class="bi bi-x-circle me-1"></i>
                    Cancel

                </button>


                <form asp-action="Delete"
                      method="post"
                      id="deleteForm"
                      class="d-inline">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           id="deleteId" />

                    <button type="submit"
                            class="btn btn-danger rounded-3 px-4">

                        <i class="bi bi-trash3 me-1"></i>
                        Yes, Delete

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        function setDeleteDetails(button) {

            const id = button.getAttribute("data-id");

            const name = button.getAttribute("data-name");

            document.getElementById("deleteId").value = id;

            document.getElementById("deleteGroupName").textContent = name;

        }

    </script>

}