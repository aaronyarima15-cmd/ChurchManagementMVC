@model ChurchManagementMVC.Models.GroupManagement

@{
    ViewData["Title"] = "Edit Group";
}

<div class="container-fluid py-4">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-pencil-square me-2"></i>
                Edit Group
            </h2>

            <p class="text-muted mb-0">
                Update the information for this church group.
            </p>
        </div>

        <div>
            <a asp-action="Index"
               class="btn btn-outline-secondary rounded-3 px-4">

                <i class="bi bi-arrow-left me-2"></i>
                Back to Groups

            </a>
        </div>

    </div>


    <!-- FORM CARD -->
    <div class="row justify-content-center">

        <div class="col-xl-9 col-lg-10 col-md-11">

            <div class="card shadow-sm border-0 rounded-4">

                <!-- CARD HEADER -->
                <div class="card-header bg-white border-0 pt-4 px-4">

                    <div class="d-flex align-items-center">

                        <div class="bg-success bg-opacity-10
                            text-success rounded-circle
                            d-flex align-items-center
                            justify-content-center me-3"
                             style="width: 50px; height: 50px;">

                            <i class="bi bi-pencil-square fs-5"></i>

                        </div>

                        <div>

                            <h5 class="fw-bold mb-1">
                                Group Information
                            </h5>

                            <p class="text-muted mb-0">
                                Update the details of this church group.
                            </p>

                        </div>

                    </div>

                </div>


                <!-- CARD BODY -->
                <div class="card-body p-4">

                    <!-- VALIDATION -->
                    <div asp-validation-summary="All"
                         class="alert alert-danger border-0 rounded-3 mb-4">
                    </div>


                    <form asp-action="Edit"
                          method="post">

                        @Html.AntiForgeryToken()


                        <!-- HIDDEN FIELDS -->
                        <input type="hidden"
                               asp-for="Id" />

                        <input type="hidden"
                               asp-for="DateCreated" />


                        <!-- GROUP NAME -->
                        <div class="mb-4">

                            <label asp-for="GroupName"
                                   class="form-label fw-semibold">

                                <i class="bi bi-people-fill me-1"></i>
                                Group Name

                            </label>

                            <input asp-for="GroupName"
                                   class="form-control form-control-lg rounded-3"
                                   placeholder="Enter group name" />

                            <span asp-validation-for="GroupName"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- DESCRIPTION -->
                        <div class="mb-4">

                            <label asp-for="Description"
                                   class="form-label fw-semibold">

                                <i class="bi bi-card-text me-1"></i>
                                Description

                            </label>

                            <textarea asp-for="Description"
                                      class="form-control form-control-lg rounded-3"
                                      rows="4"
                                      placeholder="Enter group description"></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- GROUP TYPE -->
                        <div class="mb-4">

                            <label asp-for="GroupTypeId"
                                   class="form-label fw-semibold">

                                <i class="bi bi-diagram-3-fill me-1"></i>
                                Group Type

                            </label>

                            <select asp-for="GroupTypeId"
                                    class="form-select form-select-lg rounded-3">

                                <option value="">
                                    -- Select Group Type --
                                </option>

                                @foreach (var type in ViewBag.GroupTypes)
                                {
                                    <option value="@type.Id">
                                        @type.Name
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="GroupTypeId"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- COORDINATOR -->
                        <div class="mb-4">

                            <label asp-for="CoordinatorId"
                                   class="form-label fw-semibold">

                                <i class="bi bi-person-badge-fill me-1"></i>
                                Coordinator

                            </label>

                            <select asp-for="CoordinatorId"
                                    class="form-select form-select-lg rounded-3">

                                <option value="">
                                    -- Select Coordinator --
                                </option>

                                @foreach (var member in ViewBag.Members)
                                {
                                    <option value="@member.Id">
                                        @member.FirstName @member.LastName @member.OtherNames
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="CoordinatorId"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- ACTIVITY -->
                        <div class="mb-4">

                            <label asp-for="ActivityId"
                                   class="form-label fw-semibold">

                                <i class="bi bi-calendar-event-fill me-1"></i>
                                Meeting Activity

                            </label>

                            <select asp-for="ActivityId"
                                    class="form-select form-select-lg rounded-3">

                                <option value="">
                                    -- Select Activity --
                                </option>

                                @foreach (var activity in ViewBag.Activities)
                                {
                                    <option value="@activity.Id">
                                        @activity.Day
                                        (@activity.StartTime - @activity.EndTime)
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="ActivityId"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- BUTTONS -->
                        <div class="d-flex justify-content-end gap-2 mt-4">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary rounded-3 px-4">

                                <i class="bi bi-x-circle me-1"></i>
                                Cancel

                            </a>

                            <button type="submit"
                                    class="btn btn-success rounded-3 px-4 shadow-sm">

                                <i class="bi bi-save-fill me-1"></i>
                                Save Changes

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}