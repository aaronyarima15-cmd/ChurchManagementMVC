@model ChurchManagementMVC.Models.ChurchCommittee

@{
    ViewData["Title"] = "Edit Church Committee Official";

    var members = ViewBag.Members as List<ChurchManagementMVC.Models.MembershipManagement>
                   ?? new List<ChurchManagementMVC.Models.MembershipManagement>();

    var positions = ViewBag.Positions as List<ChurchManagementMVC.Models.Position>
                    ?? new List<ChurchManagementMVC.Models.Position>();
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">

                <i class="bi bi-pencil-square me-2"></i>

                Edit Church Committee Official

            </h2>

            <p class="text-muted mb-0">

                Update the member or position assigned to this committee official.

            </p>

        </div>

        <div>

            <a asp-action="Index"
               class="btn btn-outline-secondary rounded-3 px-4">

                <i class="bi bi-arrow-left me-2"></i>

                Back to Committee

            </a>

        </div>

    </div>


    <!-- Form Card -->
    <div class="row justify-content-center">

        <div class="col-xl-8 col-lg-9 col-md-11">

            <div class="card shadow-sm border-0 rounded-4">

                <!-- Card Header -->
                <div class="card-header bg-white border-0 pt-4 px-4">

                    <div class="d-flex align-items-center">

                        <div class="bg-success bg-opacity-10
                            text-success rounded-circle
                            d-flex align-items-center
                            justify-content-center me-3"
                             style="width:48px;height:48px;">

                            <i class="bi bi-person-gear fs-4"></i>

                        </div>

                        <div>

                            <h5 class="fw-bold mb-1">
                                Update Committee Official
                            </h5>

                            <p class="text-muted mb-0 small">
                                Change the member or committee position.
                            </p>

                        </div>

                    </div>

                </div>


                <!-- Card Body -->
                <div class="card-body p-4">

                    <!-- Validation Summary -->
                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger"
                         role="alert">
                    </div>


                    <form asp-action="Edit"
                          asp-route-id="@Model.Id"
                          method="post">

                        @Html.AntiForgeryToken()


                        <!-- Hidden ID -->
                        <input type="hidden"
                               asp-for="Id" />


                        <!-- Member -->
                        <div class="mb-4">

                            <label asp-for="MemberId"
                                   class="form-label fw-semibold">

                                <i class="bi bi-person-fill me-1"></i>

                                Church Member

                            </label>


                            <select asp-for="MemberId"
                                    class="form-select form-select-lg rounded-3">

                                <option value="">
                                    -- Select Church Member --
                                </option>

                                @foreach (var member in members)
                                {
                                    <option value="@member.Id">

                                        @member.FirstName @member.LastName @member.OtherNames

                                    </option>
                                }

                            </select>


                            <span asp-validation-for="MemberId"
                                  class="text-danger small">
                            </span>


                            <div class="form-text">

                                Select the church member who should hold this
                                committee position.

                            </div>

                        </div>


                        <!-- Position -->
                        <div class="mb-4">

                            <label asp-for="PositionId"
                                   class="form-label fw-semibold">

                                <i class="bi bi-award-fill me-1"></i>

                                Committee Position

                            </label>


                            <select asp-for="PositionId"
                                    class="form-select form-select-lg rounded-3">

                                <option value="">
                                    -- Select Position --
                                </option>

                                @foreach (var position in positions)
                                {
                                    <option value="@position.Id">

                                        @position.PositionName

                                    </option>
                                }

                            </select>


                            <span asp-validation-for="PositionId"
                                  class="text-danger small">
                            </span>


                            <div class="form-text">

                                Select the committee position assigned to
                                this member.

                            </div>

                        </div>


                        <!-- Date Registered -->
                        <div class="mb-4">

                            <label class="form-label fw-semibold">

                                <i class="bi bi-calendar3 me-1"></i>

                                Date Registered

                            </label>


                            <input type="text"
                                   class="form-control form-control-lg rounded-3"
                                   value="@Model.DateRegistered.ToString("dd MMMM yyyy")"
                                   readonly />


                            <div class="form-text">

                                The original registration date cannot be changed.

                            </div>

                        </div>


                        <!-- Information -->
                        <div class="alert alert-info border-0 rounded-3">

                            <div class="d-flex">

                                <i class="bi bi-info-circle-fill me-2 mt-1"></i>

                                <div>

                                    <strong>Note:</strong>

                                    <div class="small mt-1">

                                        A member can only belong to the church
                                        committee once. The position can be
                                        changed when editing.

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- Buttons -->
                        <div class="d-flex justify-content-end gap-2 mt-4">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary rounded-3 px-4">

                                <i class="bi bi-x-circle me-1"></i>

                                Cancel

                            </a>


                            <button type="submit"
                                    class="btn btn-success rounded-3 px-4">

                                <i class="bi bi-check-circle-fill me-1"></i>

                                Save Changes

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}