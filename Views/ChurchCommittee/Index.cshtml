@model List<ChurchManagementMVC.Models.ChurchCommittee>

@{
    ViewData["Title"] = "Church Committee";
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-people-fill me-2"></i>
                Church Committee
            </h2>

            <p class="text-muted mb-0">
                Manage church officials and their positions.
            </p>
        </div>

        <div>
            <a asp-action="Create"
               class="btn btn-success rounded-3 px-4 shadow-sm">

                <i class="bi bi-person-plus-fill me-2"></i>
                Add Official

            </a>
        </div>

    </div>


    <!-- Success Message -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm"
             role="alert">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- Error Message -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm"
             role="alert">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- Committee Card -->
    <div class="card shadow-sm border-0 rounded-4">

        <div class="card-body p-0">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="ps-4">
                                    #
                                </th>

                                <th>
                                    Member Name
                                </th>

                                <th>
                                    Position
                                </th>

                                <th>
                                    Date Registered
                                </th>

                                <th class="text-center">
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @{
                                int count = 1;
                            }

                            @foreach (var official in Model)
                            {
                                <tr>

                                    <!-- Number -->
                                    <td class="ps-4 fw-semibold text-muted">
                                        @count
                                    </td>


                                    <!-- Member Name -->
                                    <td>

                                        <div class="d-flex align-items-center">

                                            <div class="bg-primary bg-opacity-10
                                                text-primary rounded-circle
                                                d-flex align-items-center
                                                justify-content-center me-3"
                                                 style="width:42px;height:42px;">

                                                <i class="bi bi-person-fill"></i>

                                            </div>

                                            <div>

                                                <div class="fw-semibold">
                                                    @official.MemberName
                                                </div>

                                                <small class="text-muted">
                                                    Committee Official
                                                </small>

                                            </div>

                                        </div>

                                    </td>


                                    <!-- Position -->
                                    <td>

                                        <span class="badge bg-primary bg-opacity-10
                                            text-primary rounded-pill px-3 py-2">

                                            <i class="bi bi-award me-1"></i>

                                            @official.PositionName

                                        </span>

                                    </td>


                                    <!-- Date Registered -->
                                    <td>

                                        <span class="text-muted">

                                            <i class="bi bi-calendar3 me-2"></i>

                                            @official.DateRegistered.ToString("dd MMM yyyy")

                                        </span>

                                    </td>


                                    <!-- Actions -->
                                    <td class="text-center">

                                        <div class="d-flex justify-content-center gap-2">

                                            <!-- Edit -->
                                            <a asp-action="Edit"
                                               asp-route-id="@official.Id"
                                               class="btn btn-sm btn-outline-success rounded-3 px-3"
                                               title="Edit Official">

                                                <i class="bi bi-pencil-square me-1"></i>
                                                Edit

                                            </a>


                                            <!-- Delete -->
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger rounded-3 px-3"
                                                    title="Remove Official"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#deleteModal"
                                                    data-id="@official.Id"
                                                    data-name="@official.MemberName"
                                                    data-position="@official.PositionName"
                                                    onclick="setDeleteDetails(this)">

                                                <i class="bi bi-trash3 me-1"></i>
                                                Delete

                                            </button>

                                        </div>

                                    </td>

                                </tr>

                                count++;
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <!-- Empty State -->

                <div class="text-center py-5">

                    <div class="mb-3">

                        <i class="bi bi-people display-4 text-muted"></i>

                    </div>

                    <h5 class="fw-bold">
                        No Church Committee Officials
                    </h5>

                    <p class="text-muted mb-4">
                        No church officials have been added yet.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-success rounded-3 px-4">

                        <i class="bi bi-person-plus-fill me-2"></i>
                        Add First Official

                    </a>

                </div>
            }

        </div>

    </div>

</div>


<!-- Delete Modal -->
<div class="modal fade"
     id="deleteModal"
     tabindex="-1"
     aria-labelledby="deleteModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow-lg rounded-4">

            <!-- Modal Header -->
            <div class="modal-header bg-danger text-white rounded-top-4">

                <h5 class="modal-title"
                    id="deleteModalLabel">

                    <i class="bi bi-trash3-fill me-2"></i>
                    Remove Committee Official

                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <!-- Modal Body -->
            <div class="modal-body text-center py-4">

                <div class="mb-3">

                    <i class="bi bi-exclamation-triangle-fill text-danger"
                       style="font-size: 50px;">
                    </i>

                </div>

                <h5 class="fw-bold">
                    Are you sure?
                </h5>

                <p class="text-muted mb-1">
                    You are about to remove:
                </p>

                <h5 id="deleteOfficialName"
                    class="fw-bold text-dark mb-1">
                </h5>

                <p id="deleteOfficialPosition"
                   class="text-primary fw-semibold">
                </p>

                <p class="text-muted small">
                    This action cannot be undone.
                </p>

            </div>


            <!-- Modal Footer -->
            <div class="modal-footer justify-content-center border-0 pb-4">

                <button type="button"
                        class="btn btn-secondary rounded-3 px-4"
                        data-bs-dismiss="modal">

                    <i class="bi bi-x-circle me-1"></i>
                    Cancel

                </button>


                <form asp-action="Delete"
                      method="post"
                      class="d-inline">

                    <input type="hidden"
                           id="deleteId"
                           name="id" />

                    <button type="submit"
                            class="btn btn-danger rounded-3 px-4">

                        <i class="bi bi-trash3 me-1"></i>
                        Yes, Remove

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        function setDeleteDetails(button) {

            const id = button.getAttribute("data-id");
            const name = button.getAttribute("data-name");
            const position = button.getAttribute("data-position");

            document.getElementById("deleteId").value = id;

            document.getElementById("deleteOfficialName").textContent = name;

            document.getElementById("deleteOfficialPosition").textContent = position;

        }

    </script>

}