@model ChurchManagementMVC.Models.IncomeReportViewModel

@{
    ViewData["Title"] = "Income Report";
}

<div class="container-fluid py-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">

                <i class="bi bi-arrow-down-circle-fill text-success me-2"></i>

                Income Report

            </h2>

            <p class="text-muted mb-0">
                Filter church collections by date and collection type.
            </p>

        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary rounded-3 px-4">

            <i class="bi bi-arrow-left me-2"></i>
            Reports

        </a>

    </div>


    <!-- FILTER CARD -->
    <div class="card shadow-sm border-0 rounded-4 mb-4">

        <div class="card-header bg-white border-0 pt-4 px-4">

            <h5 class="fw-bold mb-1">

                <i class="bi bi-funnel-fill text-success me-2"></i>

                Filter Income

            </h5>

            <p class="text-muted mb-0">
                You can use one filter or combine multiple filters.
            </p>

        </div>


        <div class="card-body p-4">

            <form asp-action="Income"
                  method="get">

                <div class="row g-3">


                    <!-- START DATE -->
                    <div class="col-md-3">

                        <label class="form-label fw-semibold">

                            <i class="bi bi-calendar-event me-1"></i>

                            Start Date

                        </label>

                        <input type="date"
                               name="startDate"
                               value="@Model.StartDate?.ToString("yyyy-MM-dd")"
                               class="form-control form-control-lg rounded-3" />

                    </div>


                    <!-- END DATE -->
                    <div class="col-md-3">

                        <label class="form-label fw-semibold">

                            <i class="bi bi-calendar-check me-1"></i>

                            End Date

                        </label>

                        <input type="date"
                               name="endDate"
                               value="@Model.EndDate?.ToString("yyyy-MM-dd")"
                               class="form-control form-control-lg rounded-3" />

                    </div>


                    <!-- COLLECTION TYPE -->
                    <div class="col-md-3">

                        <label class="form-label fw-semibold">

                            <i class="bi bi-tags me-1"></i>

                            Collection Type

                        </label>

                        <select name="collectionTypeId"
                                class="form-select form-select-lg rounded-3">

                            <option value="">
                                All Collection Types
                            </option>

                            @foreach (var type in Model.CollectionTypes)
                            {
                                if (Model.CollectionTypeId == type.Id)
                                {
                                    <option value="@type.Id" selected>
                                        @type.Name
                                    </option>
                                }
                                else
                                {
                                    <option value="@type.Id">
                                        @type.Name
                                    </option>
                                }
                            }

                        </select>

                    </div>


                    <!-- BUTTONS -->
                    <div class="col-12 mt-3">

                        <button type="submit"
                                class="btn btn-success rounded-3 px-4 shadow-sm">

                            <i class="bi bi-search me-2"></i>

                            Search

                        </button>


                        <a asp-action="Income"
                           class="btn btn-outline-secondary rounded-3 px-4 ms-2">

                            <i class="bi bi-arrow-clockwise me-2"></i>

                            Clear

                        </a>

                        <!-- EXPORT BUTTON -->
                        <a asp-action="ExportIncome"
                           asp-route-startDate="@Model.StartDate"
                           asp-route-endDate="@Model.EndDate"
                           asp-route-collectionTypeId="@Model.CollectionTypeId"
                           class="btn btn-outline-success rounded-3 px-4 ms-2">

                            <i class="bi bi-file-earmark-excel me-2"></i>
                            Export to Excel
                        </a>


                    </div>

                </div>

            </form>

        </div>

    </div>


    @if (Model.HasSearched)
    {

        <!-- TOTAL -->
        <div class="card shadow-sm border-0 rounded-4 mb-4">

            <div class="card-body p-4">

                <div class="d-flex align-items-center">

                    <div class="rounded-circle bg-success bg-opacity-10
                        text-success d-flex align-items-center
                        justify-content-center"
                         style="width:50px;height:50px;">

                        <i class="bi bi-cash-stack fs-5"></i>

                    </div>

                    <div class="ms-3">

                        <small class="text-muted">
                            Total Income
                        </small>

                        <h3 class="fw-bold text-success mb-0">

                            ₦@Model.TotalAmount.ToString("N2")

                        </h3>

                    </div>

                </div>

            </div>

        </div>


        <!-- RESULTS -->
        <div class="card shadow-sm border-0 rounded-4">

            <div class="card-header bg-white border-0 pt-4 px-4">

                <h5 class="fw-bold mb-1">
                    Income Results
                </h5>

                <p class="text-muted mb-0">

                    @Model.Results.Count record(s) found.

                </p>

            </div>


            <div class="card-body p-0">

                @if (Model.Results.Any())
                {

                    <div class="table-responsive">

                        <table class="table table-hover align-middle mb-0">

                            <thead class="table-light">

                                <tr>

                                    <th>#</th>

                                    <th>Date</th>

                                    <th>Collection Type</th>

                                    <th>Payment Method</th>

                                    <th>Notes</th>

                                    <th class="text-end">
                                        Amount
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                @{
                                    int count = 1;
                                }

                                @foreach (var collection in Model.Results)
                                {

                                    <tr>

                                        <td>
                                            @count
                                        </td>

                                        <td>
                                            @collection.CollectionDate.ToString("dd MMM yyyy")
                                        </td>

                                        <td>
                                            @collection.CollectionType?.Name
                                        </td>

                                        <td>
                                            @collection.PaymentMethod?.Name
                                        </td>

                                        <td>
                                            @(string.IsNullOrWhiteSpace(collection.Notes)
                                                ? "-"
                                                : collection.Notes)
                                        </td>

                                        <td class="text-end fw-semibold text-success">

                                            ₦@collection.Amount.ToString("N2")

                                        </td>

                                    </tr>

                                    count++;

                                }

                            </tbody>


                            <tfoot>

                                <tr class="table-light">

                                    <th colspan="5"
                                        class="text-end">

                                        TOTAL

                                    </th>

                                    <th class="text-end text-success">

                                        ₦@Model.TotalAmount.ToString("N2")

                                    </th>

                                </tr>

                            </tfoot>

                        </table>

                    </div>

                }
                else
                {

                    <div class="text-center py-5">

                        <i class="bi bi-search fs-1 text-muted"></i>

                        <h5 class="mt-3">
                            No income records found
                        </h5>

                        <p class="text-muted mb-0">
                            Try changing your filters and search again.
                        </p>

                    </div>

                }

            </div>

        </div>

    }

</div>