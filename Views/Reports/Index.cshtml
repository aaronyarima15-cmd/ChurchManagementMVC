@{
    ViewData["Title"] = "Financial Reports";
}

<div class="container-fluid py-4">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-bar-chart-line-fill text-success me-2"></i>
                Financial Reports
            </h2>

            <p class="text-muted mb-0">
                View and filter church income and expenditure records.
            </p>
        </div>

    </div>


    <!-- REPORT CARDS -->
    <div class="row g-4">


        <!-- INCOME REPORT -->
        <div class="col-md-6">

            <div class="card shadow-sm border-0 rounded-4 h-100">

                <div class="card-body p-4">

                    <div class="d-flex align-items-center mb-4">

                        <div class="rounded-circle bg-success bg-opacity-10
                            text-success d-flex align-items-center
                            justify-content-center"
                             style="width:55px;height:55px;">

                            <i class="bi bi-arrow-down-circle-fill fs-4"></i>

                        </div>

                        <div class="ms-3">

                            <h4 class="fw-bold mb-1">
                                Income Report
                            </h4>

                            <p class="text-muted mb-0">
                                View church collections and income.
                            </p>

                        </div>

                    </div>


                    <a asp-controller="Reports"
                       asp-action="Income"
                       class="btn btn-success rounded-3 px-4 shadow-sm">

                        <i class="bi bi-search me-2"></i>
                        Open Income Report

                    </a>

                </div>

            </div>

        </div>


        <!-- EXPENSE REPORT -->
        <div class="col-md-6">

            <div class="card shadow-sm border-0 rounded-4 h-100">

                <div class="card-body p-4">

                    <div class="d-flex align-items-center mb-4">

                        <div class="rounded-circle bg-danger bg-opacity-10
                            text-danger d-flex align-items-center
                            justify-content-center"
                             style="width:55px;height:55px;">

                            <i class="bi bi-arrow-up-circle-fill fs-4"></i>

                        </div>

                        <div class="ms-3">

                            <h4 class="fw-bold mb-1">
                                Expense Report
                            </h4>

                            <p class="text-muted mb-0">
                                View church expenditures and payments.
                            </p>

                        </div>

                    </div>


                    <a asp-controller="Reports"
                       asp-action="Expense"
                       class="btn btn-outline-danger rounded-3 px-4 shadow-sm">

                        <i class="bi bi-search me-2"></i>
                        Open Expense Report

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>