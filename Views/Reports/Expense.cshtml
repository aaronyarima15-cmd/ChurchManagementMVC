@model ChurchManagementMVC.Models.ExpenseReportViewModel

@{
    ViewData["Title"] = "Expense Report";
}

<div class="container-fluid py-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">

                <i class="bi bi-arrow-up-circle-fill text-danger me-2"></i>

                Expense Report

            </h2>

            <p class="text-muted mb-0">
                Filter church expenditures by date, type and payee.
            </p>

        </div>


        <a asp-action="Index"
           class="btn btn-outline-secondary rounded-3 px-4">

            <i class="bi bi-arrow-left me-2"></i>
            Reports

        </a>

    </div>


    <!-- FILTER CARD -->
    <div class="card shadow-sm border-0 rounded-4 mb-4">

        <div class="card-header bg-white border-0 pt-4 px-4">

            <h5 class="fw-bold mb-1">

                <i class="bi bi-funnel-fill text-danger me-2"></i>

                Filter Expenses

            </h5>

            <p class="text-muted mb-0">

                You can use one filter or combine multiple filters.

            </p>

        </div>


        <div class="card-body p-4">

            <form asp-action="Expense"
                  method="get">

                <div class="row g-3">


                    <!-- START DATE -->
                    <div class="col-md-2">

                        <label class="form-label fw-semibold">

                            <i class="bi bi-calendar-event me-1"></i>

                            Start Date

                        </label>

                        <input type="date"
                               name="startDate"
                               value="@Model.StartDate?.ToString("yyyy-MM-dd")"
                               class="form-control form-control-lg rounded-3" />

                    </div>


                    <!-- END DATE -->
                    <div class="col-md-2">

                        <label class="form-label fw-semibold">

                            <i class="bi bi-calendar-check me-1"></i>

                            End Date

                        </label>

                        <input type="date"
                               name="endDate"
                               value="@Model.EndDate?.ToString("yyyy-MM-dd")"
                               class="form-control form-control-lg rounded-3" />

                    </div>


                    <!-- EXPENDITURE TYPE -->
                    <div class="col-md-2">

                        <label class="form-label fw-semibold">

                            <i class="bi bi-tags me-1"></i>

                            Expenditure Type

                        </label>

                        <select name="expenditureTypeId"
                                class="form-select form-select-lg rounded-3">

                            <option value="">
                                All Expenditure Types
                            </option>

                            @foreach (var type in Model.ExpenditureTypes)
                            {
                                if (Model.ExpenditureTypeId ==
                                    type.ExpenditureTypeId)
                                {
                                    <option value="@type.ExpenditureTypeId"
                                            selected>

                                        @type.TypeName

                                    </option>
                                }
                                else
                                {
                                    <option value="@type.ExpenditureTypeId">

                                        @type.TypeName

                                    </option>
                                }
                            }

                        </select>

                    </div>


                    <!-- PAYEE -->
                    <!-- SIZE LEFT UNCHANGED -->
                    <div class="col-md-3">

                        <label class="form-label fw-semibold">

                            <i class="bi bi-person-vcard me-1"></i>

                            Paid To

                        </label>

                        <input type="text"
                               name="payeeName"
                               value="@Model.PayeeName"
                               class="form-control form-control-lg rounded-3"
                               placeholder="Person or organisation" />

                    </div>


                    <!-- BUTTONS -->
                    <div class="col-12 mt-3">

                        <button type="submit"
                                class="btn btn-danger rounded-3 px-4 shadow-sm">

                            <i class="bi bi-search me-2"></i>

                            Search

                        </button>


                        <a asp-action="Expense"
                           class="btn btn-outline-secondary rounded-3 px-4 ms-2">

                            <i class="bi bi-arrow-clockwise me-2"></i>

                            Clear

                        </a>

                        <!-- EXPORT BUTTON -->
                        <a asp-action="ExportExpense"
                           asp-route-startDate="@Model.StartDate"
                           asp-route-endDate="@Model.EndDate"
                           asp-route-expenditureTypeId="@Model.ExpenditureTypeId"
                           asp-route-payeeName="@Model.PayeeName"
                           class="btn btn-outline-danger rounded-3 px-4 ms-2">

                            <i class="bi bi-file-earmark-excel me-2"></i>
                            Export to Excel
                        </a>


                    </div>

                </div>

            </form>

        </div>

    </div>


    @if (Model.HasSearched)
    {

        <!-- TOTAL -->
        <div class="card shadow-sm border-0 rounded-4 mb-4">

            <div class="card-body p-4">

                <div class="d-flex align-items-center">

                    <div class="rounded-circle bg-danger bg-opacity-10
                        text-danger d-flex align-items-center
                        justify-content-center"
                         style="width:50px;height:50px;">

                        <i class="bi bi-cash-stack fs-5"></i>

                    </div>

                    <div class="ms-3">

                        <small class="text-muted">
                            Total Expenses
                        </small>

                        <h3 class="fw-bold text-danger mb-0">

                            ₦@Model.TotalAmount.ToString("N2")

                        </h3>

                    </div>

                </div>

            </div>

        </div>


        <!-- RESULTS -->
        <div class="card shadow-sm border-0 rounded-4">

            <div class="card-header bg-white border-0 pt-4 px-4">

                <h5 class="fw-bold mb-1">
                    Expense Results
                </h5>

                <p class="text-muted mb-0">

                    @Model.Results.Count record(s) found.

                </p>

            </div>


            <div class="card-body p-0">

                @if (Model.Results.Any())
                {

                    <div class="table-responsive">

                        <table class="table table-hover align-middle mb-0">

                            <thead class="table-light">

                                <tr>

                                    <th>#</th>

                                    <th>Date</th>

                                    <th>Expenditure Type</th>

                                    <th>Paid To</th>

                                    <th>Description</th>

                                    <th>Payment Method</th>

                                    <th>Status</th>

                                    <th class="text-end">
                                        Amount
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                @{
                                    int count = 1;
                                }

                                @foreach (var expenditure in Model.Results)
                                {

                                    <tr>

                                        <td>
                                            @count
                                        </td>

                                        <td>
                                            @expenditure.ExpenditureDate.ToString("dd MMM yyyy")
                                        </td>

                                        <td>
                                            @expenditure.ExpenditureTypeName
                                        </td>

                                        <td class="fw-semibold">

                                            @(string.IsNullOrWhiteSpace(
                                                expenditure.PayeeName)
                                                ? "-"
                                                : expenditure.PayeeName)

                                        </td>

                                        <td>
                                            @expenditure.Description
                                        </td>

                                        <td>
                                            @expenditure.PaymentMethodName
                                        </td>

                                        <td>

                                            <span class="badge
                                                @(expenditure.Status == "Approved"
                                                    ? "bg-success"
                                                    : expenditure.Status == "Rejected"
                                                        ? "bg-danger"
                                                        : "bg-warning text-dark")">

                                                @expenditure.Status

                                            </span>

                                        </td>

                                        <td class="text-end fw-semibold text-danger">

                                            ₦@expenditure.Amount.ToString("N2")

                                        </td>

                                    </tr>

                                    count++;

                                }

                            </tbody>


                            <tfoot>

                                <tr class="table-light">

                                    <th colspan="7"
                                        class="text-end">

                                        TOTAL

                                    </th>

                                    <th class="text-end text-danger">

                                        ₦@Model.TotalAmount.ToString("N2")

                                    </th>

                                </tr>

                            </tfoot>

                        </table>

                    </div>

                }
                else
                {

                    <div class="text-center py-5">

                        <i class="bi bi-search fs-1 text-muted"></i>

                        <h5 class="mt-3">
                            No expense records found
                        </h5>

                        <p class="text-muted mb-0">

                            Try changing your filters and search again.

                        </p>

                    </div>

                }

            </div>

        </div>

    }

</div>