@model ChurchManagementMVC.Models.ChurchCollectionManagement

@{
    ViewData["Title"] = "Add Group Collection";

    var group = ViewBag.Group as ChurchManagementMVC.Models.GroupManagement;

    var collectionTypes =
        ViewBag.CollectionTypes as List<ChurchManagementMVC.Models.CollectionType>
        ?? new List<ChurchManagementMVC.Models.CollectionType>();

    var paymentMethods =
        ViewBag.PaymentMethods as List<ChurchManagementMVC.Models.PaymentMethod>
        ?? new List<ChurchManagementMVC.Models.PaymentMethod>();

    var groupId = ViewBag.GroupId;
}

<div class="container-fluid py-4">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <div class="d-flex align-items-center mb-2">

                <a asp-action="GroupCollections"
                   asp-route-groupId="@groupId"
                   class="btn btn-sm btn-outline-success rounded-3 me-3">

                    <i class="bi bi-arrow-left me-1"></i>
                    Group Collections

                </a>

                <span class="text-muted">/</span>

                <span class="ms-2 text-muted">
                    Add Collection
                </span>

            </div>

            <h2 class="fw-bold mb-1">

                <i class="bi bi-cash-stack me-2"></i>

                Add Group Collection

            </h2>

            <p class="text-muted mb-0">

                @if (group != null)
                {
                    <span>
                        Record a collection for
                        <strong>@group.GroupName</strong>.
                    </span>
                }
                else
                {
                    <span>
                        Record a collection for this group.
                    </span>
                }

            </p>

        </div>

    </div>


    <!-- FORM CARD -->
    <div class="row justify-content-center">

        <div class="col-lg-8 col-xl-7">

            <div class="card shadow-sm border-0 rounded-4">

                <!-- CARD HEADER -->
                <div class="card-header bg-white border-0 pt-4 px-4">

                    <div class="d-flex align-items-center">

                        <div class="bg-success bg-opacity-10
                            text-success rounded-circle
                            d-flex align-items-center
                            justify-content-center me-3"
                             style="width: 50px; height: 50px;">

                            <i class="bi bi-cash-stack fs-5"></i>

                        </div>

                        <div>

                            <h5 class="fw-bold mb-1">
                                Collection Information
                            </h5>

                            <p class="text-muted mb-0">
                                Enter the details of the group collection.
                            </p>

                        </div>

                    </div>

                </div>


                <!-- FORM -->
                <form asp-action="CreateGroupCollection"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div class="card-body p-4">

                        <!-- VALIDATION -->
                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>


                        <!-- GROUP -->
                        <div class="mb-4">

                            <label class="form-label fw-semibold">
                                Group
                            </label>

                            <div class="form-control rounded-3 bg-light">

                                <i class="bi bi-people-fill text-success me-2"></i>

                                @if (group != null)
                                {
                                    @group.GroupName
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Group
                                    </span>
                                }

                            </div>

                            <input type="hidden"
                                   asp-for="GroupId" />

                            <div class="form-text">
                                This collection will be recorded for this group.
                            </div>

                        </div>


                        <!-- COLLECTION DATE -->
                        <div class="mb-4">

                            <label asp-for="CollectionDate"
                                   class="form-label fw-semibold">

                                Collection Date

                            </label>

                            <input asp-for="CollectionDate"
                                   type="date"
                                   class="form-control rounded-3" />

                            <span asp-validation-for="CollectionDate"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- COLLECTION TYPE -->
                        <div class="mb-4">

                            <label asp-for="CollectionTypeId"
                                   class="form-label fw-semibold">

                                Collection Type

                            </label>

                            <select asp-for="CollectionTypeId"
                                    class="form-select rounded-3">

                                <option value="">
                                    Select Collection Type
                                </option>

                                @foreach (var type in collectionTypes)
                                {
                                    <option value="@type.Id">

                                        @type.Name

                                    </option>
                                }

                            </select>

                            <span asp-validation-for="CollectionTypeId"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- AMOUNT -->
                        <div class="mb-4">

                            <label asp-for="Amount"
                                   class="form-label fw-semibold">

                                Amount

                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    ₦
                                </span>

                                <input asp-for="Amount"
                                       type="number"
                                       step="0.01"
                                       min="0"
                                       class="form-control"
                                       placeholder="0.00" />

                            </div>

                            <span asp-validation-for="Amount"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- PAYMENT METHOD -->
                        <div class="mb-4">

                            <label asp-for="PaymentMethodId"
                                   class="form-label fw-semibold">

                                Payment Method

                            </label>

                            <select asp-for="PaymentMethodId"
                                    class="form-select rounded-3">

                                <option value="">
                                    Select Payment Method
                                </option>

                                @foreach (var method in paymentMethods)
                                {
                                    <option value="@method.Id">

                                        @method.Name

                                    </option>
                                }

                            </select>

                            <span asp-validation-for="PaymentMethodId"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- NOTES -->
                        <div class="mb-4">

                            <label asp-for="Notes"
                                   class="form-label fw-semibold">

                                Notes

                            </label>

                            <textarea asp-for="Notes"
                                      class="form-control rounded-3"
                                      rows="4"
                                      placeholder="Enter any additional notes...">
                            </textarea>

                            <span asp-validation-for="Notes"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- BUTTONS -->
                        <div class="d-flex justify-content-end gap-2 pt-2">

                            <a asp-action="GroupCollections"
                               asp-route-groupId="@groupId"
                               class="btn btn-outline-secondary rounded-3 px-4">

                                <i class="bi bi-x-circle me-1"></i>
                                Cancel

                            </a>

                            <button type="submit"
                                    class="btn btn-success rounded-3 px-4">

                                <i class="bi bi-save me-1"></i>
                                Save Collection

                            </button>

                        </div>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}