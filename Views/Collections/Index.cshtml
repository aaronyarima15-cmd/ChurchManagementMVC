@model List<ChurchManagementMVC.Models.ChurchCollectionManagement>

@{
    ViewData["Title"] = "Collections";
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-cash-stack me-2"></i>
                Collections
            </h2>

            <p class="text-muted mb-0">
                Manage church collections and payments.
            </p>
        </div>

        <div>
            <a asp-action="Create"
               class="btn btn-success rounded-3 px-4 shadow-sm">

                <i class="bi bi-plus-circle me-2"></i>
                New Collection

            </a>
        </div>

    </div>

    <!-- Error Message -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 rounded-3 mb-4">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["Error"]
        </div>
    }

    <!-- Collections Card -->
    <div class="card shadow-sm border-0 rounded-4">

        <!-- Card Header -->
        <div class="card-header bg-white border-0 pt-4 px-4">

            <div class="d-flex align-items-center">

                <div class="bg-success bg-opacity-10
                    text-success rounded-circle
                    d-flex align-items-center
                    justify-content-center me-3"
                     style="width: 50px; height: 50px;">

                    <i class="bi bi-wallet2 fs-5"></i>

                </div>

                <div>

                    <h5 class="fw-bold mb-1">
                        Collection Records
                    </h5>

                    <p class="text-muted mb-0">
                        View and manage recorded church collections.
                    </p>

                </div>

            </div>

        </div>

        <!-- Table -->
        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th class="ps-4">
                                ID
                            </th>

                            <th>
                                Date
                            </th>

                            <th>
                                Type
                            </th>

                            <th>
                                Amount
                            </th>

                            <th>
                                Payment Method
                            </th>

                            <th>
                                Notes
                            </th>

                            <th class="text-end pe-4">
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var collection in Model)
                            {
                                <tr>

                                    <!-- ID -->
                                    <td class="ps-4 fw-semibold">
                                        @collection.Id
                                    </td>

                                    <!-- Date -->
                                    <td>
                                        @collection.CollectionDate.ToString("dd MMM yyyy")
                                    </td>

                                    <!-- Collection Type -->
                                    <td>

                                        @if (collection.CollectionType != null)
                                        {
                                            <span class="fw-semibold">
                                                @collection.CollectionType.Name
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                N/A
                                            </span>
                                        }

                                    </td>

                                    <!-- Amount -->
                                    <td>

                                        <span class="fw-semibold">
                                            ₦@collection.Amount.ToString("N2")
                                        </span>

                                    </td>

                                    <!-- Payment Method -->
                                    <td>

                                        @if (collection.PaymentMethod != null)
                                        {
                                            <span>
                                                @collection.PaymentMethod.Name
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                N/A
                                            </span>
                                        }

                                    </td>

                                    <!-- Notes -->
                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(collection.Notes))
                                        {
                                            <span>
                                                @collection.Notes
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No notes
                                            </span>
                                        }

                                    </td>

                                    <!-- Actions -->
                                    <td class="text-end pe-4">

                                        <div class="d-flex justify-content-end gap-2">

                                            <!-- Edit -->
                                            <a asp-action="Edit"
                                               asp-route-id="@collection.Id"
                                               class="btn btn-sm btn-outline-success rounded-3 px-3">

                                                <i class="bi bi-pencil-square me-1"></i>
                                                Edit

                                            </a>

                                            <!-- Delete -->
                                            <form asp-action="Delete"
                                                  asp-route-id="@collection.Id"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger rounded-3 px-3"
                                                        onclick="return confirm('Are you sure you want to delete this collection?');">

                                                    <i class="bi bi-trash me-1"></i>
                                                    Delete

                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <!-- Empty State -->
                            <tr>

                                <td colspan="7"
                                    class="text-center py-5">

                                    <div class="text-muted">

                                        <i class="bi bi-inbox fs-1 d-block mb-3"></i>

                                        <h5 class="fw-semibold">
                                            No Collections Found
                                        </h5>

                                        <p class="mb-3">
                                            There are no church collections recorded yet.
                                        </p>

                                        <a asp-action="Create"
                                           class="btn btn-success rounded-3 px-4">

                                            <i class="bi bi-plus-circle me-2"></i>
                                            Add Collection

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>