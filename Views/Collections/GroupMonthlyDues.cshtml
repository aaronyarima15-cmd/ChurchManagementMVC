@model ChurchManagementMVC.ViewModels.GroupMonthlyDuesVM

@{
    ViewData["Title"] = "Group Monthly Dues";
    var monthNames = new[]
    {
        "Jan", "Feb", "Mar", "Apr", "May", "Jun",
        "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"
    };
    var totalAmount = Model.Members
        .SelectMany(member => member.MonthlyAmounts)
        .Sum(amount => amount ?? 0m);
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a asp-action="GroupCollections"
               asp-route-groupId="@Model.GroupId"
               class="btn btn-sm btn-outline-success rounded-3 mb-2">
                <i class="bi bi-arrow-left me-1"></i>
                Group Collections
            </a>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-calendar2-check text-success me-2"></i>
                Monthly Member Dues
            </h2>
            <p class="text-muted mb-0">
                Record each member's monthly payment for <strong>@Model.GroupName</strong>.
            </p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
            <form method="get" asp-action="GroupMonthlyDues" class="d-flex align-items-end gap-2">
                <input type="hidden" name="groupId" value="@Model.GroupId" />
                <div>
                    <label class="form-label fw-semibold" for="year">Year</label>
                    <input id="year" name="year" type="number" min="1900" max="9999"
                           value="@Model.Year" class="form-control" />
                </div>
                <button type="submit" class="btn btn-outline-success">
                    <i class="bi bi-search"></i>
                    View Year
                </button>
            </form>

            <div class="text-end">
                <div class="text-muted small">Total recorded for @Model.Year</div>
                <div class="fs-4 fw-bold text-success">₦@totalAmount.ToString("N2")</div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0">@Model.GroupName — @Model.Year</h5>
        </div>
        <div class="card-body">
            <p class="text-muted">
                Enter the amount each member paid for each month. Leave a month empty if no payment was made.
                Saving the page updates the recorded amounts for this group and year.
            </p>

            @if (Model.Members.Count == 0)
            {
                <div class="alert alert-warning mb-0">
                    This group has no members yet. Add members to the group before recording monthly dues.
                </div>
            }
            else
            {
                <form asp-action="SaveGroupMonthlyDues" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="GroupId" value="@Model.GroupId" />
                    <input type="hidden" name="GroupName" value="@Model.GroupName" />
                    <input type="hidden" name="Year" value="@Model.Year" />

                    <div class="table-responsive">
                        <table class="table table-bordered table-hover align-middle text-center">
                            <thead class="table-success">
                                <tr>
                                    <th class="text-start">Member</th>
                                    @foreach (var monthName in monthNames)
                                    {
                                        <th>@monthName</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @for (int memberIndex = 0; memberIndex < Model.Members.Count; memberIndex++)
                                {
                                    <tr>
                                        <td class="text-start fw-semibold">
                                            @Model.Members[memberIndex].MemberName
                                            <input type="hidden"
                                                   name="Members[@memberIndex].MemberId"
                                                   value="@Model.Members[memberIndex].MemberId" />
                                            <input type="hidden"
                                                   name="Members[@memberIndex].MemberName"
                                                   value="@Model.Members[memberIndex].MemberName" />
                                        </td>
                                        @for (int month = 0; month < 12; month++)
                                        {
                                            <td>
                                                <input type="number"
                                                       name="Members[@memberIndex].MonthlyAmounts[@month]"
                                                       value="@(Model.Members[memberIndex].MonthlyAmounts[month]?.ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                                       min="0"
                                                       step="0.01"
                                                       class="form-control form-control-sm text-end"
                                                       aria-label="@Model.Members[memberIndex].MemberName @monthNames[month] payment" />
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex justify-content-end mt-3">
                        <button type="submit" class="btn btn-success px-4">
                            <i class="bi bi-save me-1"></i>
                            Save Monthly Payments
                        </button>
                    </div>
                </form>
            }
        </div>
    </div>
</div>