@model ChurchManagementMVC.Models.ChurchCollectionManagement

@{
    ViewData["Title"] = "Create Collection";

    var collectionTypes =
        ViewBag.CollectionTypes as List<ChurchManagementMVC.Models.CollectionType>
        ?? new List<ChurchManagementMVC.Models.CollectionType>();

    var paymentMethods =
        ViewBag.PaymentMethods as List<ChurchManagementMVC.Models.PaymentMethod>
        ?? new List<ChurchManagementMVC.Models.PaymentMethod>();
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-cash-stack me-2"></i>
                Create Collection
            </h2>

            <p class="text-muted mb-0">
                Record a new church collection.
            </p>
        </div>

        <div>
            <a asp-action="Index"
               class="btn btn-outline-secondary rounded-3 px-4">

                <i class="bi bi-arrow-left me-2"></i>
                Back to Collections

            </a>
        </div>

    </div>


    <!-- Collection Form -->
    <div class="row justify-content-center">

        <div class="col-xl-8 col-lg-9">

            <div class="card shadow-sm border-0 rounded-4">

                <!-- Card Header -->
                <div class="card-header bg-white border-0 pt-4 px-4">

                    <div class="d-flex align-items-center">

                        <div class="bg-success bg-opacity-10
                            text-success rounded-circle
                            d-flex align-items-center
                            justify-content-center me-3"
                             style="width: 50px; height: 50px;">

                            <i class="bi bi-wallet2 fs-5"></i>

                        </div>

                        <div>

                            <h5 class="fw-bold mb-1">
                                Collection Information
                            </h5>

                            <p class="text-muted mb-0">
                                Enter the details of the collection below.
                            </p>

                        </div>

                    </div>

                </div>


                <!-- Card Body -->
                <div class="card-body p-4">

                    <form asp-action="Create" method="post">

                        @Html.AntiForgeryToken()


                        <!-- Validation Summary -->
                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger border-0 rounded-3 mb-4">
                        </div>


                        <!-- Collection Date -->
                        <div class="mb-4">

                            <label asp-for="CollectionDate"
                                   class="form-label fw-semibold">

                                <i class="bi bi-calendar3 me-1"></i>
                                Collection Date

                            </label>

                            <input asp-for="CollectionDate"
                                   type="date"
                                   class="form-control form-control-lg rounded-3" />

                            <span asp-validation-for="CollectionDate"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- Collection Type -->
                        <div class="mb-4">

                            <label asp-for="CollectionTypeId"
                                   class="form-label fw-semibold">

                                <i class="bi bi-tags-fill me-1"></i>
                                Collection Type

                            </label>

                            <select asp-for="CollectionTypeId"
                                    class="form-select form-select-lg rounded-3">

                                <option value="">
                                    -- Select Collection Type --
                                </option>

                                @foreach (var type in collectionTypes)
                                {
                                    <option value="@type.Id">
                                        @type.Name
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="CollectionTypeId"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- Amount -->
                        <div class="mb-4">

                            <label asp-for="Amount"
                                   class="form-label fw-semibold">

                                <i class="bi bi-currency-exchange me-1"></i>
                                Amount

                            </label>

                            <div class="input-group input-group-lg">

                                <span class="input-group-text bg-light">
                                    ₦
                                </span>

                                <input asp-for="Amount"
                                       type="number"
                                       step="0.01"
                                       class="form-control rounded-end-3"
                                       placeholder="Enter amount" />

                            </div>

                            <span asp-validation-for="Amount"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- Payment Method -->
                        <div class="mb-4">

                            <label asp-for="PaymentMethodId"
                                   class="form-label fw-semibold">

                                <i class="bi bi-credit-card-fill me-1"></i>
                                Payment Method

                            </label>

                            <select asp-for="PaymentMethodId"
                                    class="form-select form-select-lg rounded-3">

                                <option value="">
                                    -- Select Payment Method --
                                </option>

                                @foreach (var method in paymentMethods)
                                {
                                    <option value="@method.Id">
                                        @method.Name
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="PaymentMethodId"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- Notes -->
                        <div class="mb-4">

                            <label asp-for="Notes"
                                   class="form-label fw-semibold">

                                <i class="bi bi-journal-text me-1"></i>
                                Notes

                            </label>

                            <textarea asp-for="Notes"
                                      class="form-control form-control-lg rounded-3"
                                      rows="4"
                                      placeholder="Optional notes">
                            </textarea>

                            <span asp-validation-for="Notes"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- Buttons -->
                        <div class="d-flex justify-content-end gap-2 mt-4">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary rounded-3 px-4">

                                <i class="bi bi-x-circle me-1"></i>
                                Cancel

                            </a>

                            <button type="submit"
                                    class="btn btn-success rounded-3 px-4 shadow-sm">

                                <i class="bi bi-check-circle-fill me-1"></i>
                                Save Collection

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}