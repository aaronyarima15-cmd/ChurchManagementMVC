@model List<ChurchManagementMVC.ViewModels.UserRoleViewModel>

@{
    ViewData["Title"] = "User Management";
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-people-fill me-2"></i>
                User Management
            </h2>

            <p class="text-muted mb-0">
                Manage church management system users and their roles.
            </p>
        </div>

    </div>


    <!-- Success Message -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show
            border-0 rounded-3 shadow-sm"
             role="alert">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- Error Message -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show
            border-0 rounded-3 shadow-sm"
             role="alert">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- Users Card -->
    <div class="card shadow-sm border-0 rounded-4">

        <div class="card-header bg-white border-0 pt-4 px-4">

            <div class="d-flex align-items-center">

                <div class="bg-success bg-opacity-10
                    text-success rounded-circle
                    d-flex align-items-center
                    justify-content-center me-3"
                     style="width: 50px; height: 50px;">

                    <i class="bi bi-person-lines-fill fs-5"></i>

                </div>

                <div>

                    <h5 class="fw-bold mb-1">
                        System Users
                    </h5>

                    <p class="text-muted mb-0">
                        View registered users and manage their roles.
                    </p>

                </div>

            </div>

        </div>


        <div class="card-body p-0">

            @if (Model == null || !Model.Any())
            {
                <!-- Empty State -->

                <div class="text-center py-5">

                    <div class="mb-3">

                        <i class="bi bi-people display-4 text-muted"></i>

                    </div>

                    <h5 class="fw-bold">
                        No Users Found
                    </h5>

                    <p class="text-muted mb-0">
                        There are currently no registered users.
                    </p>

                </div>
            }
            else
            {
                <!-- Users Table -->

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="ps-4">
                                    #
                                </th>

                                <th>
                                    Name
                                </th>

                                <th>
                                    Email
                                </th>

                                <th>
                                    Role
                                </th>

                                <th class="text-center">
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @{
                                int count = 1;
                            }

                            @foreach (var user in Model)
                            {
                                <tr>

                                    <!-- Number -->
                                    <td class="ps-4 fw-semibold text-muted">
                                        @count
                                    </td>


                                    <!-- Name -->
                                    <td>

                                        <div class="d-flex align-items-center">

                                            <div class="bg-success bg-opacity-10
                                                text-success rounded-circle
                                                d-flex align-items-center
                                                justify-content-center me-3"
                                                 style="width: 40px; height: 40px;">

                                                <i class="bi bi-person-fill"></i>

                                            </div>

                                            <span class="fw-semibold">
                                                @user.FullName
                                            </span>

                                        </div>

                                    </td>


                                    <!-- Email -->
                                    <td>

                                        <span class="text-muted">

                                            <i class="bi bi-envelope me-2"></i>

                                            @user.Email

                                        </span>

                                    </td>


                                    <!-- Role -->
                                    <td>

                                        @if (user.Role == "Admin")
                                        {
                                            <span class="badge bg-danger bg-opacity-10
                                                text-danger rounded-pill
                                                px-3 py-2">

                                                <i class="bi bi-shield-fill-check me-1"></i>
                                                @user.Role

                                            </span>
                                        }
                                        else if (user.Role == "Pastor")
                                        {
                                            <span class="badge bg-primary bg-opacity-10
                                                text-primary rounded-pill
                                                px-3 py-2">

                                                <i class="bi bi-person-badge-fill me-1"></i>
                                                @user.Role

                                            </span>
                                        }
                                        else if (user.Role == "Treasurer")
                                        {
                                            <span class="badge bg-success bg-opacity-10
                                                text-success rounded-pill
                                                px-3 py-2">

                                                <i class="bi bi-cash-stack me-1"></i>
                                                @user.Role

                                            </span>
                                        }
                                        else if (user.Role == "Secretary")
                                        {
                                            <span class="badge bg-warning bg-opacity-10
                                                text-warning-emphasis rounded-pill
                                                px-3 py-2">

                                                <i class="bi bi-file-earmark-text-fill me-1"></i>
                                                @user.Role

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-10
                                                text-secondary rounded-pill
                                                px-3 py-2">

                                                <i class="bi bi-person-fill me-1"></i>
                                                @user.Role

                                            </span>
                                        }

                                    </td>


                                    <!-- Action -->
                                    <td class="text-center">

                                        <a asp-controller="Admin"
                                           asp-action="ChangeRole"
                                           asp-route-id="@user.Id"
                                           class="btn btn-sm btn-outline-success rounded-3 px-3">

                                            <i class="bi bi-person-gear me-1"></i>
                                            Change Role

                                        </a>

                                    </td>

                                </tr>

                                count++;
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>