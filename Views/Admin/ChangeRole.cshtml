@model ChurchManagementMVC.ViewModels.UserRoleViewModel

@{
    ViewData["Title"] = "Change User Role";
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-person-gear me-2"></i>
                Change User Role
            </h2>

            <p class="text-muted mb-0">
                Update the role and permissions assigned to this user.
            </p>
        </div>

        <div>
            <a asp-controller="Admin"
               asp-action="Users"
               class="btn btn-outline-secondary rounded-3 px-4">

                <i class="bi bi-arrow-left me-2"></i>
                Back to Users

            </a>
        </div>

    </div>


    <!-- Main Card -->
    <div class="row justify-content-center">

        <div class="col-xl-6 col-lg-7 col-md-9">

            <div class="card shadow-sm border-0 rounded-4">

                <!-- Card Header -->
                <div class="card-header bg-white border-0 pt-4 px-4">

                    <div class="d-flex align-items-center">

                        <div class="bg-success bg-opacity-10
                            text-success rounded-circle
                            d-flex align-items-center
                            justify-content-center me-3"
                             style="width: 50px; height: 50px;">

                            <i class="bi bi-person-badge-fill fs-5"></i>

                        </div>

                        <div>

                            <h5 class="fw-bold mb-1">
                                User Role
                            </h5>

                            <p class="text-muted mb-0">
                                Manage this user's system access.
                            </p>

                        </div>

                    </div>

                </div>


                <!-- Card Body -->
                <div class="card-body p-4">

                    <!-- Validation -->
                    <div asp-validation-summary="All"
                         class="alert alert-danger border-0 rounded-3 mb-4">
                    </div>


                    <!-- User Information -->
                    <div class="alert alert-light border rounded-3 mb-4">

                        <div class="d-flex align-items-start">

                            <i class="bi bi-person-circle
                                text-success fs-4 me-3">
                            </i>

                            <div>

                                <div class="fw-semibold">
                                    User Information
                                </div>

                                <small class="text-muted">
                                    The information below identifies the
                                    account whose role you are changing.
                                </small>

                            </div>

                        </div>

                    </div>


                    <!-- Full Name -->
                    <div class="mb-4">

                        <label class="form-label fw-semibold">

                            <i class="bi bi-person me-1"></i>
                            Full Name

                        </label>

                        <input type="text"
                               class="form-control form-control-lg rounded-3"
                               value="@Model.FullName"
                               readonly />

                    </div>


                    <!-- Email -->
                    <div class="mb-4">

                        <label class="form-label fw-semibold">

                            <i class="bi bi-envelope me-1"></i>
                            Email Address

                        </label>

                        <input type="text"
                               class="form-control form-control-lg rounded-3"
                               value="@Model.Email"
                               readonly />

                    </div>


                    <!-- Change Role Form -->
                    <form asp-controller="Admin"
                          asp-action="ChangeRole"
                          method="post">

                        <input type="hidden"
                               asp-for="Id" />


                        <!-- Role -->
                        <div class="mb-4">

                            <label asp-for="Role"
                                   class="form-label fw-semibold">

                                <i class="bi bi-shield-check me-1"></i>
                                Select Role

                            </label>

                            <select asp-for="Role"
                                    class="form-select form-select-lg rounded-3">

                                <option value="Member">
                                    Member
                                </option>

                                <option value="Pastor">
                                    Pastor
                                </option>

                                <option value="Secretary">
                                    Secretary
                                </option>

                                <option value="Treasurer">
                                    Treasurer
                                </option>

                                <option value="Admin">
                                    Admin
                                </option>

                            </select>

                            <small class="text-muted d-block mt-2">

                                <i class="bi bi-info-circle me-1"></i>

                                The selected role determines which areas
                                of the system this user can access.

                            </small>

                        </div>


                        <!-- Actions -->
                        <div class="d-flex justify-content-end gap-2 mt-4">

                            <a asp-controller="Admin"
                               asp-action="Users"
                               class="btn btn-outline-secondary rounded-3 px-4">

                                <i class="bi bi-x-circle me-1"></i>
                                Cancel

                            </a>

                            <button type="submit"
                                    class="btn btn-success rounded-3 px-4 shadow-sm">

                                <i class="bi bi-check-circle-fill me-1"></i>
                                Save Role

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>