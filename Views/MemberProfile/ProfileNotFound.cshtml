@{
    ViewData["Title"] = "Profile Not Found";
}

<div class="container-fluid py-4">

    <div class="card border-0 shadow-sm">

        <div class="card-body text-center p-5">

            <div class="mb-4">

                <i class="bi bi-person-x"
                   style="font-size: 4rem; color: #dc3545;"></i>

            </div>

            <h3 class="fw-bold mb-3">
                Member Profile Not Found
            </h3>

            <p class="text-muted mb-4">

                Your login account was found, but we could not find
                a church member record with the same email address.

            </p>

            <p class="text-muted">

                Please contact the church administrator or secretary
                to make sure your email address is correctly registered
                in your member profile.

            </p>

            <a asp-controller="Home"
               asp-action="Dashboard"
               class="btn btn-success rounded-3 px-4 mt-3">

                <i class="bi bi-speedometer2 me-1"></i>
                Back to Dashboard

            </a>

        </div>

    </div>

</div>