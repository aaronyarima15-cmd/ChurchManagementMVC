@model IEnumerable<ChurchManagementMVC.Models.MembershipManagement>

@{
    ViewData["Title"] = "Members";
}

<div class="container-fluid py-4">

    <!-- =========================================================
         PAGE HEADER
    ========================================================== -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-people-fill text-success me-2"></i>
                Church Members
            </h2>

            <p class="text-muted mb-0">
                Manage registered church members.
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-action="Create"
               class="btn btn-success">
                <i class="bi bi-person-plus-fill me-1"></i>
                Add Member
            </a>

            <a href="https://localhost:44360/api/Members/export/excel"
               class="btn btn-outline-success">
                <i class="bi bi-file-earmark-excel me-1"></i>
                Export to Excel
            </a>


        </div>

    </div>


    <!-- =========================================================
         MEMBERS TABLE
    ========================================================== -->

    <div class="card shadow-sm border-0">

        <div class="card-header bg-success text-white">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="mb-0">
                    <i class="bi bi-people-fill me-2"></i>
                    Members
                </h5>

                <span class="badge bg-light text-success">
                    @Model.Count() Members
                </span>

            </div>

        </div>


        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th class="text-center">
                                #
                            </th>

                            <th class="text-center">
                                Photo
                            </th>

                            <th>
                                Name
                            </th>

                            <th>
                                Date of Birth
                            </th>

                            <th>
                                Age
                            </th>

                            <th>
                                Gender
                            </th>

                            <th>
                                Marital Status
                            </th>

                            <th>
                                Phone
                            </th>

                            <th>
                                Card Number
                            </th>

                            <th>
                                Baptized
                            </th>

                            <th>
                                Relationship
                            </th>

                            <th>
                                Status
                            </th>

                            <th class="text-center">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            int number = 1;

                            foreach (var member in Model)
                            {
                                <tr>

                                    <!-- NUMBER -->

                                    <td class="text-center">
                                        @number
                                    </td>


                                    <!-- PHOTO -->

                                    <td class="text-center">

                                        @if (!string.IsNullOrWhiteSpace(
                                            member.PhotoPath))
                                        {
                                            <img src="@member.PhotoPath"
                                                 alt="@member.FirstName @member.LastName @member.OtherNames"
                                                 class="rounded-circle border shadow-sm"
                                                 style="width: 48px; height: 48px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div class="rounded-circle bg-light border d-inline-flex align-items-center justify-content-center"
                                                 style="width: 48px; height: 48px;">

                                                <i class="bi bi-person-fill text-secondary"
                                                   style="font-size: 25px;">
                                                </i>

                                            </div>
                                        }

                                    </td>


                                    <!-- NAME -->

                                    <td>

                                        <div class="fw-semibold">
                                            @(string.Join(" ", new[] { member.FirstName, member.LastName, member.OtherNames }.Where(name => !string.IsNullOrWhiteSpace(name))))
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(
                                            member.Email))
                                        {
                                            <small class="text-muted">
                                                @member.Email
                                            </small>
                                        }

                                    </td>


                                    <!-- DATE OF BIRTH -->

                                    <td>
                                        @member.DateOfBirth.ToString(
                                            "dd MMM yyyy")
                                    </td>


                                    <!-- AGE -->

                                    <td>
                                        @member.Age
                                    </td>


                                    <!-- GENDER -->

                                    <td>
                                        @member.Gender
                                    </td>


                                    <!-- MARITAL STATUS -->

                                    <td>
                                        @member.MaritalStatusDescription
                                    </td>


                                    <!-- PHONE -->

                                    <td>
                                        @member.PhoneNumber
                                    </td>


                                    <!-- CARD NUMBER -->

                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(
                                            member.CardNumber))
                                        {
                                            <span class="badge bg-success">
                                                @member.CardNumber
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }

                                    </td>


                                    <!-- BAPTIZED -->

                                    <td>

                                        @if (member.IsBaptized)
                                        {
                                            <span class="badge bg-success">
                                                Yes
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                No
                                            </span>
                                        }

                                    </td>


                                    <!-- RELATIONSHIP -->

                                    <td>
                                        @member.Relationship?.Name
                                    </td>


                                    <!-- STATUS -->

                                    <td>

                                        @if (member.Status != null)
                                        {
                                            <span class="badge bg-success">
                                                @member.Status.StatusName
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }

                                    </td>


                                    <!-- ACTIONS -->

                                    <td class="text-center">

                                        <div class="d-flex justify-content-center gap-1">

                                            <!-- EDIT -->

                                            <a asp-action="Edit"
                                               asp-route-id="@member.Id"
                                               class="btn btn-sm btn-outline-success"
                                               title="Edit Member">

                                                <i class="bi bi-pencil-square"></i>

                                            </a>


                                            <!-- PROFILE -->

                                            <a asp-controller="MemberProfile"
                                               asp-action="Index"
                                               asp-route-id="@member.Id"
                                               class="btn btn-sm btn-outline-primary"
                                               title="View Profile">

                                                <i class="bi bi-person-vcard"></i>

                                            </a>


                                            <!-- DELETE -->

                                            <form asp-action="Delete"
                                                  asp-route-id="@member.Id"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to delete this member?');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        title="Delete Member">

                                                    <i class="bi bi-trash"></i>

                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>

                                number++;
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="13"
                                    class="text-center py-5">

                                    <div class="text-muted">

                                        <i class="bi bi-people"
                                           style="font-size: 45px;">
                                        </i>

                                        <h5 class="mt-3">
                                            No Members Found
                                        </h5>

                                        <p class="mb-3">
                                            There are currently no registered members.
                                        </p>

                                        <a asp-action="Create"
                                           class="btn btn-success">

                                            <i class="bi bi-person-plus-fill me-1"></i>
                                            Add First Member

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<!-- =============================================================
     PRINT STYLING
============================================================== -->

<style>

    @@media print
    {
        body *
        {
            visibility: hidden;
        }

        .container-fluid,
        .container-fluid *
        {
            visibility: visible;
        }

        .container-fluid
        {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
        }

        .btn,
        button,
        form
        {
            display: none !important;
        }

        .card
        {
            border: none !important;
            box-shadow: none !important;
        }

        .card-header
        {
            background: none !important;
            color: black !important;
            border-bottom: 2px solid #198754 !important;
        }

        table
        {
            font-size: 11px;
        }

        th,
        td
        {
            padding: 6px !important;
        }

        @@page
        {
            margin: 10mm;
        }
    }

</style>