@model ChurchManagementMVC.Models.PaymentMethod

@{
    ViewData["Title"] = "Edit Payment Method";
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-credit-card-fill text-success me-2"></i>
                Edit Payment Method
            </h2>
            <p class="text-muted mb-0">
                Update the payment method information.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary rounded-3 px-4">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Payment Methods
        </a>
    </div>

    <!-- Form Card -->
    <div class="row justify-content-center">
        <div class="col-xl-8 col-lg-9 col-md-10">

            <div class="card shadow-sm border-0 rounded-4">

                <!-- Card Header -->
                <div class="card-header bg-white border-0 pt-4 px-4">
                    <div class="d-flex align-items-center">

                        <div class="bg-success bg-opacity-10 text-success rounded-circle
                            d-flex align-items-center justify-content-center me-3"
                             style="width: 50px; height: 50px;">
                            <i class="bi bi-credit-card-fill fs-4"></i>
                        </div>

                        <div>
                            <h5 class="fw-bold mb-1">
                                Payment Method Information
                            </h5>
                            <p class="text-muted mb-0">
                                Modify the payment method details below.
                            </p>
                        </div>

                    </div>
                </div>

                <!-- Card Body -->
                <div class="card-body p-4">

                    <form asp-action="Edit" method="post">

                        @Html.AntiForgeryToken()

                        <!-- Hidden ID -->
                        <input type="hidden" asp-for="Id" />

                        <!-- Validation -->
                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger border-0 rounded-3">
                        </div>

                        <!-- Payment Method -->
                        <div class="mb-4">

                            <label asp-for="Name"
                                   class="form-label fw-semibold">
                                <i class="bi bi-wallet2 text-success me-1"></i>
                                Payment Method
                            </label>

                            <input asp-for="Name"
                                   class="form-control form-control-lg rounded-3"
                                   placeholder="e.g. Cash, Bank Transfer, POS" />

                            <span asp-validation-for="Name"
                                  class="text-danger small">
                            </span>

                        </div>

                        <!-- Information Alert -->
                        <div class="alert alert-success border-0 rounded-3 mb-4">
                            <div class="d-flex">
                                <i class="bi bi-info-circle-fill me-2 mt-1"></i>
                                <div>
                                    <strong>Payment Method</strong>
                                    <p class="mb-0 small">
                                        Make sure the payment method name is clear
                                        and can be easily identified when recording
                                        financial transactions.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- Buttons -->
                        <div class="d-flex justify-content-end gap-2">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary rounded-3 px-4">
                                <i class="bi bi-x-circle me-1"></i>
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-success rounded-3 px-4 shadow-sm">
                                <i class="bi bi-check-circle me-1"></i>
                                Update Payment Method
                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}