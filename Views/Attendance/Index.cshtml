@model List<ChurchManagementMVC.Models.AttendanceSummary>

@{
    ViewData["Title"] = "Attendance";

    var latestSunday =
        Model?
            .Where(a =>
                a.ServiceType == "Sunday Service")
            .OrderByDescending(a => a.AttendanceDate)
            .FirstOrDefault();

    var men =
        latestSunday?.Men ?? 0;

    var women =
        latestSunday?.Women ?? 0;

    var children =
        latestSunday?.Children ?? 0;

    var total =
        latestSunday?.Total ?? 0;
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">
                Attendance
            </h2>

            <p class="text-muted mb-0">
                Sunday service attendance summary
            </p>

        </div>


        <div class="d-flex gap-2">

            @if (
                User.IsInRole("Admin") ||
                User.IsInRole("Pastor") ||
                User.IsInRole("Secretary"))
            {
                <a asp-action="Create"
                   class="btn btn-success">

                    <i class="bi bi-plus-circle me-1"></i>

                    Record Attendance

                </a>
            }

            <a asp-action="ExportToExcel"
               class="btn btn-outline-success">

                <i class="bi bi-file-earmark-excel me-1"></i>

                Export to Excel

            </a>

        </div>

    </div>


    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h5 class="fw-bold mb-1">

                        <i class="bi bi-calendar-check text-success me-2"></i>

                        Latest Sunday Service

                    </h5>

                    @if (latestSunday != null)
                    {
                        <p class="text-muted mb-0">

                            @latestSunday.AttendanceDate.ToString("dd MMMM yyyy")

                        </p>
                    }
                    else
                    {
                        <p class="text-muted mb-0">

                            No Sunday attendance recorded yet.

                        </p>
                    }

                </div>


                @if (latestSunday != null)
                {
                    <div class="text-end">

                        <small class="text-muted">
                            Total Attendance
                        </small>

                        <h2 class="fw-bold text-success mb-0">

                            @total

                        </h2>

                    </div>
                }

            </div>

        </div>

    </div>



    <div class="row g-4">

        <div class="col-md-6 col-xl-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Men
                            </p>

                            <h2 class="fw-bold mb-0">
                                @men
                            </h2>

                        </div>

                        <div class="text-success">

                            <i class="bi bi-person-fill"
                               style="font-size: 2rem;">
                            </i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-md-6 col-xl-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Women
                            </p>

                            <h2 class="fw-bold mb-0">
                                @women
                            </h2>

                        </div>

                        <div class="text-success">

                            <i class="bi bi-person-fill"
                               style="font-size: 2rem;">
                            </i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-md-6 col-xl-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Children
                            </p>

                            <h2 class="fw-bold mb-0">
                                @children
                            </h2>

                        </div>

                        <div class="text-success">

                            <i class="bi bi-people-fill"
                               style="font-size: 2rem;">
                            </i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-md-6 col-xl-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Total Attendance
                            </p>

                            <h2 class="fw-bold text-success mb-0">
                                @total
                            </h2>

                        </div>

                        <div class="text-success">

                            <i class="bi bi-bar-chart-fill"
                               style="font-size: 2rem;">
                            </i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>



    @if (Model != null && Model.Count > 0)
    {
        <div class="card shadow-sm border-0 mt-4">

            <div class="card-header bg-white py-3">

                <h5 class="fw-bold mb-0">

                    <i class="bi bi-clock-history me-2 text-success"></i>

                    Attendance History

                </h5>

            </div>


            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    Date
                                </th>

                                <th>
                                    Service
                                </th>

                                <th>
                                    Men
                                </th>

                                <th>
                                    Women
                                </th>

                                <th>
                                    Children
                                </th>

                                <th>
                                    Total
                                </th>

                                <th class="text-end">
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var attendance in Model
                                .OrderByDescending(a => a.AttendanceDate))
                            {
                                <tr>

                                    <td>
                                        @attendance.AttendanceDate.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        @attendance.ServiceType
                                    </td>

                                    <td>
                                        @attendance.Men
                                    </td>

                                    <td>
                                        @attendance.Women
                                    </td>

                                    <td>
                                        @attendance.Children
                                    </td>

                                    <td class="fw-bold">
                                        @attendance.Total
                                    </td>

                                    <td class="text-end">

                                        @if (
                                            User.IsInRole("Admin") ||
                                            User.IsInRole("Pastor") ||
                                            User.IsInRole("Secretary"))
                                        {
                                            <a asp-action="Edit"
                                               asp-route-id="@attendance.Id"
                                               class="btn btn-sm btn-outline-success">

                                                <i class="bi bi-pencil"></i>

                                            </a>


                                            <form asp-action="Delete"
                                                  asp-route-id="@attendance.Id"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to delete this attendance record?');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger">

                                                    <i class="bi bi-trash"></i>

                                                </button>

                                            </form>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

</div>


@if (TempData["Success"] != null)
{
    <script>

        alert('@TempData["Success"]');

    </script>
}


@if (TempData["Error"] != null)
{
    <script>

        alert('@TempData["Error"]');

    </script>
}