@model List<ChurchManagementMVC.Models.GroupMember>

@{
    ViewData["Title"] = "Group Leaders";

    var group = ViewBag.Group as ChurchManagementMVC.Models.GroupManagement;
    var groupId = ViewBag.GroupId;
}

<div class="container-fluid py-4">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <div class="d-flex align-items-center mb-2">

                <a asp-controller="Groups"
                   asp-action="Manage"
                   asp-route-id="@groupId"
                   class="btn btn-sm btn-outline-success rounded-3 me-3">

                    <i class="bi bi-arrow-left me-1"></i>
                    Group Dashboard

                </a>

                <span class="text-muted">/</span>

                <span class="ms-2 text-muted">
                    Leaders
                </span>

            </div>

            <h2 class="fw-bold mb-1">

                <i class="bi bi-person-badge-fill me-2"></i>

                @if (group != null)
                {
                    @group.GroupName
                }
                else
                {
                    <span>Group</span>
                }

            </h2>

            <p class="text-muted mb-0">
                Manage leaders and leadership roles for this group.
            </p>

        </div>

        <div>

            <a asp-action="Create"
               asp-route-groupId="@groupId"
               class="btn btn-success rounded-3 px-4 shadow-sm">

                <i class="bi bi-person-plus-fill me-2"></i>
                Add Leader

            </a>

        </div>

    </div>


    <!-- LEADERS CARD -->
    <div class="card shadow-sm border-0 rounded-4">

        <div class="card-header bg-white border-0 pt-4 px-4">

            <div class="d-flex align-items-center">

                <div class="bg-success bg-opacity-10
                    text-success rounded-circle
                    d-flex align-items-center
                    justify-content-center me-3"
                     style="width: 50px; height: 50px;">

                    <i class="bi bi-person-badge-fill fs-5"></i>

                </div>

                <div>

                    <h5 class="fw-bold mb-1">
                        Group Leaders
                    </h5>

                    <p class="text-muted mb-0">
                        Members with leadership responsibilities in this group.
                    </p>

                </div>

            </div>

        </div>


        <div class="card-body p-0">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="ps-4">
                                    #
                                </th>

                                <th>
                                    Leader
                                </th>

                                <th>
                                    Phone
                                </th>

                                <th>
                                    Role
                                </th>

                                <th>
                                    Date Joined
                                </th>

                                <th class="text-end pe-4">
                                    Actions
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @{
                                int count = 1;
                            }

                            @foreach (var leader in Model)
                            {
                                <tr>

                                    <td class="ps-4 fw-semibold text-muted">
                                        @count
                                    </td>

                                    <td>

                                        <div class="d-flex align-items-center">

                                            <div class="bg-success bg-opacity-10
                                                text-success rounded-circle
                                                d-flex align-items-center
                                                justify-content-center me-3"
                                                 style="width: 40px; height: 40px;">

                                                <i class="bi bi-person-badge-fill"></i>

                                            </div>

                                            <div>

                                                @if (leader.Member != null)
                                                {
                                                    <div class="fw-semibold">

                                                        @leader.Member.FirstName
                                                        @leader.Member.LastName

                                                    </div>

                                                    @if (!string.IsNullOrWhiteSpace(leader.Member.Email))
                                                    {
                                                        <small class="text-muted">

                                                            <i class="bi bi-envelope me-1"></i>

                                                            @leader.Member.Email

                                                        </small>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-muted">
                                                        Member not found
                                                    </span>
                                                }

                                            </div>

                                        </div>

                                    </td>

                                    <td>

                                        @if (leader.Member != null &&
                                             !string.IsNullOrWhiteSpace(leader.Member.PhoneNumber))
                                        {
                                            <span>

                                                <i class="bi bi-telephone me-1 text-success"></i>

                                                @leader.Member.PhoneNumber

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                N/A
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        <span class="badge bg-success bg-opacity-10
                                            text-success rounded-pill px-3 py-2">

                                            <i class="bi bi-person-badge-fill me-1"></i>

                                            @leader.Role

                                        </span>

                                    </td>

                                    <td>

                                        <i class="bi bi-calendar-check me-1 text-success"></i>

                                        @leader.DateJoined
                                        .ToLocalTime()
                                        .ToString("dd MMM yyyy")

                                    </td>

                                    <td class="text-end pe-4">

                                        <a asp-action="Edit"
                                           asp-route-id="@leader.Id"
                                           class="btn btn-sm btn-outline-success rounded-3 px-3">

                                            <i class="bi bi-pencil-square me-1"></i>
                                            Edit

                                        </a>

                                    </td>

                                </tr>

                                count++;
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <div class="mb-3">

                        <i class="bi bi-person-badge display-4 text-muted"></i>

                    </div>

                    <h5 class="fw-bold">
                        No Leaders Yet
                    </h5>

                    <p class="text-muted mb-4">
                        This group does not have any assigned leaders yet.
                    </p>

                    <a asp-action="Create"
                       asp-route-groupId="@groupId"
                       class="btn btn-success rounded-3 px-4">

                        <i class="bi bi-person-plus-fill me-2"></i>
                        Add First Leader

                    </a>

                </div>
            }

        </div>

    </div>

</div>