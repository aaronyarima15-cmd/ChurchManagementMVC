@model ChurchManagementMVC.Models.GroupMember

@{
    ViewData["Title"] = "Add Group Member";

    var group = ViewBag.Group as ChurchManagementMVC.Models.GroupManagement;
    var members = ViewBag.Members as List<ChurchManagementMVC.Models.MembershipManagement>
                  ?? new List<ChurchManagementMVC.Models.MembershipManagement>();

    var groupId = ViewBag.GroupId;
}

<div class="container-fluid py-4">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <div class="d-flex align-items-center mb-2">

                <a asp-action="Index"
                   asp-route-groupId="@groupId"
                   class="btn btn-sm btn-outline-success rounded-3 me-3">

                    <i class="bi bi-arrow-left me-1"></i>
                    Group Members

                </a>

                <span class="text-muted">/</span>

                <span class="ms-2 text-muted">
                    Add Member
                </span>

            </div>

            <h2 class="fw-bold mb-1">
                <i class="bi bi-person-plus-fill me-2"></i>
                Add Member
            </h2>

            <p class="text-muted mb-0">

                @if (group != null)
                {
                    <span>
                        Add a church member to
                        <strong>@group.GroupName</strong>.
                    </span>
                }
                else
                {
                    <span>
                        Add a church member to this group.
                    </span>
                }

            </p>

        </div>

    </div>


    <!-- FORM CARD -->
    <div class="row justify-content-center">

        <div class="col-lg-8 col-xl-7">

            <div class="card shadow-sm border-0 rounded-4">

                <!-- CARD HEADER -->
                <div class="card-header bg-white border-0 pt-4 px-4">

                    <div class="d-flex align-items-center">

                        <div class="bg-success bg-opacity-10
                            text-success rounded-circle
                            d-flex align-items-center
                            justify-content-center me-3"
                             style="width: 50px; height: 50px;">

                            <i class="bi bi-person-plus-fill fs-5"></i>

                        </div>

                        <div>

                            <h5 class="fw-bold mb-1">
                                Member Information
                            </h5>

                            <p class="text-muted mb-0">
                                Select a church member and assign a role.
                            </p>

                        </div>

                    </div>

                </div>


                <!-- FORM -->
                <form asp-action="Create"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div class="card-body p-4">

                        <!-- VALIDATION -->
                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>


                        <!-- GROUP -->
                        <div class="mb-4">

                            <label class="form-label fw-semibold">
                                Group
                            </label>

                            <div class="form-control rounded-3 bg-light">

                                <i class="bi bi-people-fill text-success me-2"></i>

                                @if (group != null)
                                {
                                    @group.GroupName
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Group
                                    </span>
                                }

                            </div>

                            <input type="hidden"
                                   asp-for="GroupId" />

                        </div>


                        <!-- MEMBER -->
                        <div class="mb-4">

                            <label asp-for="MemberId"
                                   class="form-label fw-semibold">

                                Church Member

                            </label>

                            <select asp-for="MemberId"
                                    class="form-select rounded-3">

                                <option value="">
                                    Select Church Member
                                </option>

                                @foreach (var member in members)
                                {
                                    <option value="@member.Id">

                                        @member.FirstName @member.LastName @member.OtherNames

                                        @if (!string.IsNullOrWhiteSpace(member.CardNumber))
                                        {
                                            <text>
                                                - @member.CardNumber
                                            </text>
                                        }

                                    </option>
                                }

                            </select>

                            <span asp-validation-for="MemberId"
                                  class="text-danger">
                            </span>

                            <div class="form-text">
                                Select an existing church member to add to this group.
                            </div>

                        </div>


                        <!-- ROLE -->
                        <div class="mb-4">

                            <label asp-for="Role"
                                   class="form-label fw-semibold">

                                Group Role

                            </label>

                            <select asp-for="Role"
                                    class="form-select rounded-3">

                                <option value="Member">
                                    Member
                                </option>

                                <option value="Leader">
                                    Leader
                                </option>

                                <option value="Assistant Leader">
                                    Assistant Leader
                                </option>

                                <option value="Secretary">
                                    Secretary
                                </option>

                                <option value="Assistant Secretary">
                                    Assistant Secretary
                                </option>

                                <option value="Treasurer">
                                    Treasurer
                                </option>

                                <option value="Assistant Treasurer">
                                    Assistant Treasurer
                                </option>

                                <option value="Coordinator">
                                    Coordinator
                                </option>

                            </select>

                            <span asp-validation-for="Role"
                                  class="text-danger">
                            </span>

                            <div class="form-text">
                                Choose the responsibility of the member within this group.
                            </div>

                        </div>


                        <!-- DATE JOINED -->
                        <div class="mb-4">

                            <label asp-for="DateJoined"
                                   class="form-label fw-semibold">

                                Date Joined

                            </label>

                            <input asp-for="DateJoined"
                                   type="date"
                                   class="form-control rounded-3" />

                            <span asp-validation-for="DateJoined"
                                  class="text-danger">
                            </span>

                            <div class="form-text">
                                The date this member joined the group.
                            </div>

                        </div>


                        <!-- BUTTONS -->
                        <div class="d-flex justify-content-end gap-2 pt-2">

                            <a asp-action="Index"
                               asp-route-groupId="@groupId"
                               class="btn btn-outline-secondary rounded-3 px-4">

                                <i class="bi bi-x-circle me-1"></i>
                                Cancel

                            </a>

                            <button type="submit"
                                    class="btn btn-success rounded-3 px-4">

                                <i class="bi bi-person-plus-fill me-1"></i>
                                Add Member

                            </button>

                        </div>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}