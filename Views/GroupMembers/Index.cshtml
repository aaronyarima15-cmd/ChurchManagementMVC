@model List<ChurchManagementMVC.Models.GroupMember>

@{
    ViewData["Title"] = "Group Members";

    var group = ViewBag.Group as ChurchManagementMVC.Models.GroupManagement;
    var groupId = ViewBag.GroupId;
}

<div class="container-fluid py-4">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <div class="d-flex align-items-center mb-2">

                <a asp-controller="Groups"
                   asp-action="Manage"
                   asp-route-id="@groupId"
                   class="btn btn-sm btn-outline-success rounded-3 me-3">

                    <i class="bi bi-arrow-left me-1"></i>
                    Group Dashboard

                </a>

                <span class="text-muted">
                    /
                </span>

                <span class="ms-2 text-muted">
                    Members
                </span>

            </div>

            <h2 class="fw-bold mb-1">

                <i class="bi bi-people-fill me-2"></i>

                @if (group != null)
                {
                    @group.GroupName
                }
                else
                {
                    <span>Group</span>
                }

            </h2>

            <p class="text-muted mb-0">
                Manage members belonging to this group.
            </p>

        </div>


        <div>

            <a asp-action="Create"
               asp-route-groupId="@groupId"
               class="btn btn-success rounded-3 px-4 shadow-sm">

                <i class="bi bi-person-plus-fill me-2"></i>
                Add Member

            </a>

        </div>

    </div>


    <!-- ERROR MESSAGE -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show
            border-0 rounded-3 shadow-sm"
             role="alert">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- SUCCESS MESSAGE -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show
            border-0 rounded-3 shadow-sm"
             role="alert">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- SUMMARY CARD -->
    <div class="row g-4 mb-4">

        <!-- TOTAL MEMBERS -->
        <div class="col-md-4">

            <div class="card shadow-sm border-0 rounded-4 h-100">

                <div class="card-body p-4">

                    <div class="d-flex align-items-center">

                        <div class="bg-success bg-opacity-10
                            text-success rounded-circle
                            d-flex align-items-center
                            justify-content-center me-3"
                             style="width: 50px; height: 50px;">

                            <i class="bi bi-people-fill fs-5"></i>

                        </div>

                        <div>

                            <div class="text-muted small">
                                Total Members
                            </div>

                            <h4 class="fw-bold mb-0">
                                @(Model?.Count ?? 0)
                            </h4>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- LEADERS -->
        <div class="col-md-4">

            <div class="card shadow-sm border-0 rounded-4 h-100">

                <div class="card-body p-4">

                    <div class="d-flex align-items-center">

                        <div class="bg-success bg-opacity-10
                            text-success rounded-circle
                            d-flex align-items-center
                            justify-content-center me-3"
                             style="width: 50px; height: 50px;">

                            <i class="bi bi-person-badge-fill fs-5"></i>

                        </div>

                        <div>

                            <div class="text-muted small">
                                Leaders
                            </div>

                            <h4 class="fw-bold mb-0">

                                @(Model?.Count(x =>
                                    !string.IsNullOrWhiteSpace(x.Role) &&
                                    x.Role.ToLower() != "member") ?? 0)

                            </h4>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- GROUP -->
        <div class="col-md-4">

            <div class="card shadow-sm border-0 rounded-4 h-100">

                <div class="card-body p-4">

                    <div class="d-flex align-items-center">

                        <div class="bg-success bg-opacity-10
                            text-success rounded-circle
                            d-flex align-items-center
                            justify-content-center me-3"
                             style="width: 50px; height: 50px;">

                            <i class="bi bi-diagram-3-fill fs-5"></i>

                        </div>

                        <div>

                            <div class="text-muted small">
                                Group
                            </div>

                            <h6 class="fw-bold mb-0">

                                @if (group != null)
                                {
                                    @group.GroupName
                                }
                                else
                                {
                                    <span>N/A</span>
                                }

                            </h6>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- MEMBERS CARD -->
    <div class="card shadow-sm border-0 rounded-4">

        <!-- CARD HEADER -->
        <div class="card-header bg-white border-0 pt-4 px-4">

            <div class="d-flex align-items-center">

                <div class="bg-success bg-opacity-10
                    text-success rounded-circle
                    d-flex align-items-center
                    justify-content-center me-3"
                     style="width: 50px; height: 50px;">

                    <i class="bi bi-person-lines-fill fs-5"></i>

                </div>

                <div>

                    <h5 class="fw-bold mb-1">
                        Group Members
                    </h5>

                    <p class="text-muted mb-0">
                        Members currently assigned to this group.
                    </p>

                </div>

            </div>

        </div>


        <!-- CARD BODY -->
        <div class="card-body p-0">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="ps-4"
                                    style="width: 70px;">
                                    #
                                </th>

                                <th>
                                    Member
                                </th>

                                <th>
                                    Phone
                                </th>

                                <th>
                                    Role
                                </th>

                                <th>
                                    Date Joined
                                </th>

                                <th class="text-end pe-4">
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @{
                                int count = 1;
                            }

                            @foreach (var groupMember in Model)
                            {
                                <tr>

                                    <!-- NUMBER -->
                                    <td class="ps-4 fw-semibold text-muted">
                                        @count
                                    </td>


                                    <!-- MEMBER -->
                                    <td>

                                        <div class="d-flex align-items-center">

                                            <div class="bg-success bg-opacity-10
                                                text-success rounded-circle
                                                d-flex align-items-center
                                                justify-content-center me-3"
                                                 style="width: 40px; height: 40px;">

                                                <i class="bi bi-person-fill"></i>

                                            </div>

                                            <div>

                                                @if (groupMember.Member != null)
                                                {
                                                    <div class="fw-semibold">

                                                        @groupMember.Member.FirstName
                                                        @groupMember.Member.LastName

                                                    </div>

                                                    @if (!string.IsNullOrWhiteSpace(groupMember.Member.Email))
                                                    {
                                                        <small class="text-muted">

                                                            <i class="bi bi-envelope me-1"></i>

                                                            @groupMember.Member.Email

                                                        </small>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-muted">
                                                        Member not found
                                                    </span>
                                                }

                                            </div>

                                        </div>

                                    </td>


                                    <!-- PHONE -->
                                    <td>

                                        @if (groupMember.Member != null &&
                                             !string.IsNullOrWhiteSpace(groupMember.Member.PhoneNumber))
                                        {
                                            <span>

                                                <i class="bi bi-telephone me-1 text-success"></i>

                                                @groupMember.Member.PhoneNumber

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                N/A
                                            </span>
                                        }

                                    </td>


                                    <!-- ROLE -->
                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(groupMember.Role))
                                        {
                                            if (groupMember.Role.ToLower() == "member")
                                            {
                                                <span class="badge bg-success bg-opacity-10
                                                    text-success rounded-pill px-3 py-2">

                                                    <i class="bi bi-person-fill me-1"></i>

                                                    Member

                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success bg-opacity-10
                                                    text-success rounded-pill px-3 py-2">

                                                    <i class="bi bi-person-badge-fill me-1"></i>

                                                    @groupMember.Role

                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Member
                                            </span>
                                        }

                                    </td>


                                    <!-- DATE JOINED -->
                                    <td>

                                        <span>

                                            <i class="bi bi-calendar-check me-1 text-success"></i>

                                            @groupMember.DateJoined.ToLocalTime().ToString("dd MMM yyyy")

                                        </span>

                                    </td>


                                    <!-- ACTIONS -->
                                    <td class="text-end pe-4">

                                        <div class="d-flex justify-content-end gap-2">

                                            <!-- EDIT -->
                                            <a asp-action="Edit"
                                               asp-route-id="@groupMember.Id"
                                               class="btn btn-sm btn-outline-success rounded-3 px-3">

                                                <i class="bi bi-pencil-square me-1"></i>
                                                Edit

                                            </a>


                                            <!-- DELETE -->
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger rounded-3 px-3"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#deleteModal"
                                                    data-id="@groupMember.Id"
                                                    data-member="@($"{groupMember.Member?.FirstName} {groupMember.Member?.LastName} {groupMember.Member?.OtherNames}")"
                                                    onclick="setDeleteDetails(this)">

                                                <i class="bi bi-person-dash-fill me-1"></i>
                                                Remove

                                            </button>

                                        </div>

                                    </td>

                                </tr>

                                count++;
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <!-- EMPTY STATE -->
                <div class="text-center py-5">

                    <div class="mb-3">

                        <i class="bi bi-people display-4 text-muted"></i>

                    </div>

                    <h5 class="fw-bold">
                        No Members Yet
                    </h5>

                    <p class="text-muted mb-4">
                        This group does not have any members yet.
                    </p>

                    <a asp-action="Create"
                       asp-route-groupId="@groupId"
                       class="btn btn-success rounded-3 px-4">

                        <i class="bi bi-person-plus-fill me-2"></i>
                        Add First Member

                    </a>

                </div>
            }

        </div>

    </div>

</div>


<!-- DELETE CONFIRMATION MODAL -->
<div class="modal fade"
     id="deleteModal"
     tabindex="-1"
     aria-labelledby="deleteModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow rounded-4">

            <!-- MODAL HEADER -->
            <div class="modal-header border-0">

                <h5 class="modal-title text-danger fw-bold"
                    id="deleteModalLabel">

                    <i class="bi bi-exclamation-triangle-fill me-2"></i>

                    Remove Member

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <!-- MODAL BODY -->
            <div class="modal-body">

                <p>
                    Are you sure you want to remove this member from the group?
                </p>

                <div class="alert alert-light border rounded-3">

                    <div class="d-flex align-items-center">

                        <div class="bg-danger bg-opacity-10
                            text-danger rounded-circle
                            d-flex align-items-center
                            justify-content-center me-3"
                             style="width: 40px; height: 40px;">

                            <i class="bi bi-person-fill"></i>

                        </div>

                        <div>

                            <strong>
                                Member:
                            </strong>

                            <div id="deleteMemberName"
                                 class="text-muted mt-1">
                            </div>

                        </div>

                    </div>

                </div>

                <p class="text-muted small mb-0">

                    <i class="bi bi-info-circle me-1"></i>

                    This will only remove the member from this group.
                    The church member will not be deleted.

                </p>

            </div>


            <!-- MODAL FOOTER -->
            <div class="modal-footer border-0">

                <button type="button"
                        class="btn btn-outline-secondary rounded-3 px-4"
                        data-bs-dismiss="modal">

                    <i class="bi bi-x-circle me-1"></i>
                    Cancel

                </button>


                <form asp-action="Delete"
                      method="post"
                      class="d-inline">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           id="deleteId" />

                    <input type="hidden"
                           name="groupId"
                           value="@groupId" />

                    <button type="submit"
                            class="btn btn-danger rounded-3 px-4">

                        <i class="bi bi-person-dash-fill me-1"></i>
                        Yes, Remove

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        function setDeleteDetails(button) {

            const id = button.getAttribute("data-id");

            const member = button.getAttribute("data-member");

            document.getElementById("deleteId").value = id;

            document.getElementById("deleteMemberName").textContent = member;

        }

    </script>

}