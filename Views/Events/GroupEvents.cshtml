@model List<ChurchManagementMVC.Models.EventManagement>

@{
    ViewData["Title"] = "Group Events";

    var group = ViewBag.Group as ChurchManagementMVC.Models.GroupManagement;
    var groupId = ViewBag.GroupId;
}

<div class="container-fluid py-4">

    <!-- =========================================================
         PAGE HEADER
    ========================================================== -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <div class="d-flex align-items-center gap-2 mb-2">

                <a asp-controller="Groups"
                   asp-action="Manage"
                   asp-route-id="@groupId"
                   class="btn btn-light border rounded-3">

                    <i class="bi bi-arrow-left me-1"></i>
                    Back to Group
                </a>

            </div>

            <h3 class="fw-bold mb-1">
                <i class="bi bi-calendar-event text-success me-2"></i>
                Group Events
            </h3>

            <p class="text-muted mb-0">
                Events for
                <strong>@group?.GroupName</strong>
            </p>
        </div>

        <div>

            <a asp-controller="Events"
               asp-action="CreateGroupEvent"
               asp-route-groupId="@groupId"
               class="btn btn-success rounded-3 px-4">

                <i class="bi bi-plus-circle me-1"></i>
                Add Event
            </a>

        </div>

    </div>


    <!-- =========================================================
         SUMMARY CARDS
    ========================================================== -->

    <div class="row g-4 mb-4">

        <!-- Total Events -->

        <div class="col-md-4">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body d-flex align-items-center">

                    <div class="bg-success bg-opacity-10 rounded-4 p-3 me-3">

                        <i class="bi bi-calendar-event text-success fs-3"></i>

                    </div>

                    <div>

                        <small class="text-muted">
                            Total Events
                        </small>

                        <h4 class="fw-bold mb-0">
                            @Model.Count
                        </h4>

                    </div>

                </div>

            </div>

        </div>


        <!-- Upcoming Events -->

        <div class="col-md-4">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body d-flex align-items-center">

                    <div class="bg-primary bg-opacity-10 rounded-4 p-3 me-3">

                        <i class="bi bi-calendar-check text-primary fs-3"></i>

                    </div>

                    <div>

                        <small class="text-muted">
                            Upcoming Events
                        </small>

                        <h4 class="fw-bold mb-0">

                            @Model.Count(e =>
                                e.EventDate.Date >= DateTime.Today)

                        </h4>

                    </div>

                </div>

            </div>

        </div>


        <!-- Past Events -->

        <div class="col-md-4">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body d-flex align-items-center">

                    <div class="bg-secondary bg-opacity-10 rounded-4 p-3 me-3">

                        <i class="bi bi-calendar-x text-secondary fs-3"></i>

                    </div>

                    <div>

                        <small class="text-muted">
                            Past Events
                        </small>

                        <h4 class="fw-bold mb-0">

                            @Model.Count(e =>
                                e.EventDate.Date < DateTime.Today)

                        </h4>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         EVENTS TABLE
    ========================================================== -->

    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">

                <div>

                    <h5 class="fw-bold mb-1">
                        <i class="bi bi-list-ul me-2 text-success"></i>
                        Events
                    </h5>

                    <small class="text-muted">
                        All events assigned to this group
                    </small>

                </div>

            </div>


            @if (Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>Event</th>
                                <th>Type</th>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Location</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var ev in Model)
                            {
                                <tr>

                                    <td>

                                        <div class="fw-semibold">
                                            @ev.EventName
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(ev.Description))
                                        {
                                            <small class="text-muted">
                                                @ev.Description
                                            </small>
                                        }

                                    </td>


                                    <td>

                                        @if (ev.EventType != null)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success">
                                                @ev.EventType.Name
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Not specified
                                            </span>
                                        }

                                    </td>


                                    <td>
                                        @ev.EventDate.ToString("dd MMM yyyy")
                                    </td>


                                    <td>
                                        @ev.EventTime.ToString(@"hh\:mm")
                                    </td>


                                    <td>
                                        @ev.Location
                                    </td>


                                    <td>

                                        @if (ev.Status == "Upcoming")
                                        {
                                            <span class="badge bg-primary">
                                                @ev.Status
                                            </span>
                                        }
                                        else if (ev.Status == "Completed")
                                        {
                                            <span class="badge bg-success">
                                                @ev.Status
                                            </span>
                                        }
                                        else if (ev.Status == "Cancelled")
                                        {
                                            <span class="badge bg-danger">
                                                @ev.Status
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @ev.Status
                                            </span>
                                        }

                                    </td>


                                    <td class="text-end">

                                        <div class="d-flex justify-content-end gap-2">

                                            <a asp-controller="Events"
                                               asp-action="EditGroupEvent"
                                               asp-route-id="@ev.Id"
                                               class="btn btn-sm btn-outline-primary rounded-3">

                                                <i class="bi bi-pencil"></i>
                                                Edit

                                            </a>


                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger rounded-3"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#deleteEventModal-@ev.Id">

                                                <i class="bi bi-trash"></i>
                                                Delete

                                            </button>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <!-- =================================================
                     EMPTY STATE
                ================================================== -->

                <div class="text-center py-5">

                    <div class="mb-3">

                        <i class="bi bi-calendar-x text-muted"
                           style="font-size: 3rem;"></i>

                    </div>

                    <h5 class="fw-bold">
                        No Events Found
                    </h5>

                    <p class="text-muted mb-4">
                        This group does not have any events yet.
                    </p>

                    <a asp-controller="Events"
                       asp-action="CreateGroupEvent"
                       asp-route-groupId="@groupId"
                       class="btn btn-success rounded-3 px-4">

                        <i class="bi bi-plus-circle me-1"></i>
                        Add First Event

                    </a>

                </div>
            }

        </div>

    </div>

</div>


<!-- =============================================================
     DELETE MODALS
============================================================== -->
@foreach (var ev in Model)
{
    <div class="modal fade"
         id="deleteEventModal-@ev.Id"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content border-0 rounded-4 shadow">

                <div class="modal-header">

                    <h5 class="modal-title fw-bold">

                        <i class="bi bi-exclamation-triangle text-danger me-2"></i>
                        Delete Event

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>


                <div class="modal-body">

                    <p class="mb-1">
                        Are you sure you want to delete:
                    </p>

                    <p class="fw-bold mb-0">
                        @ev.EventName
                    </p>

                    <p class="text-muted small mt-2 mb-0">
                        This action cannot be undone.
                    </p>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-light border rounded-3"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>


                    <form asp-controller="Events"
                          asp-action="Delete"
                          asp-route-id="@ev.Id"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-danger rounded-3">

                            <i class="bi bi-trash me-1"></i>
                            Delete

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>
}