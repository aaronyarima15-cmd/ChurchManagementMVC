@model List<ChurchManagementMVC.Models.EventManagement>

@{
    ViewData["Title"] = "Events";
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-calendar-event me-2"></i>
                Events
            </h2>

            <p class="text-muted mb-0">
                Manage church events and activities.
            </p>
        </div>

        <div>
            <a asp-action="Create"
               class="btn btn-success rounded-3 px-4 shadow-sm">

                <i class="bi bi-plus-circle me-2"></i>
                New Event

            </a>
        </div>

    </div>

    <!-- Error Message -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 rounded-3 mb-4">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["Error"]

        </div>
    }

    <!-- Events Card -->
    <div class="card shadow-sm border-0 rounded-4">

        <!-- Card Header -->
        <div class="card-header bg-white border-0 pt-4 px-4">

            <div class="d-flex align-items-center">

                <div class="bg-success bg-opacity-10
                    text-success rounded-circle
                    d-flex align-items-center
                    justify-content-center me-3"
                     style="width: 50px; height: 50px;">

                    <i class="bi bi-calendar-event fs-5"></i>

                </div>

                <div>

                    <h5 class="fw-bold mb-1">
                        Event Records
                    </h5>

                    <p class="text-muted mb-0">
                        View and manage scheduled church events.
                    </p>

                </div>

            </div>

        </div>

        <!-- Table -->
        <div class="card-body p-0">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="ps-4">
                                    ID
                                </th>

                                <th>
                                    Name
                                </th>

                                <th>
                                    Type
                                </th>

                                <th>
                                    Date
                                </th>

                                <th>
                                    Time
                                </th>

                                <th>
                                    Location
                                </th>

                                <th>
                                    Status
                                </th>

                                <th class="text-end pe-4">
                                    Actions
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var e in Model)
                            {
                                <tr>

                                    <!-- ID -->
                                    <td class="ps-4 fw-semibold">
                                        @e.Id
                                    </td>

                                    <!-- Event Name -->
                                    <td>

                                        <div class="d-flex align-items-center">

                                            <div class="bg-success bg-opacity-10
                                                text-success rounded-circle
                                                d-flex align-items-center
                                                justify-content-center me-3"
                                                 style="width: 38px; height: 38px;">

                                                <i class="bi bi-calendar2-event"></i>

                                            </div>

                                            <span class="fw-semibold">
                                                @e.EventName
                                            </span>

                                        </div>

                                    </td>

                                    <!-- Event Type -->
                                    <td>

                                        @if (e.EventType != null)
                                        {
                                            <span class="badge bg-success bg-opacity-10
                                                text-success rounded-pill px-3 py-2">

                                                @e.EventType.Name

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                N/A
                                            </span>
                                        }

                                    </td>

                                    <!-- Date -->
                                    <td>
                                        @e.EventDate.ToString("dd MMM yyyy")
                                    </td>

                                    <!-- Time -->
                                    <td>
                                        @e.EventTime
                                    </td>

                                    <!-- Location -->
                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(e.Location))
                                        {
                                            <span>
                                                <i class="bi bi-geo-alt me-1 text-muted"></i>
                                                @e.Location
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                N/A
                                            </span>
                                        }

                                    </td>

                                    <!-- Status -->
                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(e.Status))
                                        {
                                            <span class="badge bg-success bg-opacity-10
                                                text-success rounded-pill px-3 py-2">

                                                @e.Status

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                N/A
                                            </span>
                                        }

                                    </td>

                                    <!-- Actions -->
                                    <td class="text-end pe-4">

                                        <div class="d-flex justify-content-end gap-2">

                                            <!-- Edit -->
                                            <a asp-action="Edit"
                                               asp-route-id="@e.Id"
                                               class="btn btn-sm btn-outline-success rounded-3 px-3">

                                                <i class="bi bi-pencil-square me-1"></i>
                                                Edit

                                            </a>

                                            <!-- Delete -->
                                            <form asp-action="Delete"
                                                  asp-route-id="@e.Id"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger rounded-3 px-3"
                                                        onclick="return confirm('Are you sure you want to delete this event?');">

                                                    <i class="bi bi-trash me-1"></i>
                                                    Delete

                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <!-- Empty State -->
                <div class="text-center py-5">

                    <div class="text-muted">

                        <i class="bi bi-calendar-x fs-1 d-block mb-3"></i>

                        <h5 class="fw-semibold">
                            No Events Found
                        </h5>

                        <p class="mb-3">
                            There are no church events recorded yet.
                        </p>

                        <a asp-action="Create"
                           class="btn btn-success rounded-3 px-4">

                            <i class="bi bi-plus-circle me-2"></i>
                            Add First Event

                        </a>

                    </div>

                </div>
            }

        </div>

    </div>

</div>