@model ChurchManagementMVC.Models.CommunionReportVM

@{
    ViewData["Title"] = "Members Present";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-people-fill text-success"></i>
                Members Present
            </h2>
            <p class="text-muted mb-0">Holy Communion attendance for the selected date</p>
        </div>

        <a asp-controller="Communion"
           asp-action="Report"
           asp-route-date="@Model.CommunionDate.ToString("yyyy-MM-dd")"
           class="btn btn-outline-success">
            <i class="bi bi-arrow-left"></i>
            Back to Annual Report
        </a>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0"><i class="bi bi-calendar-event"></i> Select Communion Date</h5>
        </div>
        <div class="card-body">
            <form method="get" asp-controller="Communion" asp-action="PresentMembers">
                <div class="row align-items-end g-3">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold" for="date">Communion Date</label>
                        <input id="date"
                               type="date"
                               name="date"
                               value="@Model.CommunionDate.ToString("yyyy-MM-dd")"
                               class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-search"></i>
                            View Record
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Members Present on @Model.CommunionDate.ToString("dd/MM/yyyy")</h5>
            <span class="badge bg-light text-success">@Model.MembersPresent.Count Present</span>
        </div>
        <div class="card-body">
            @if (Model.MembersPresent.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle mb-0">
                        <thead class="table-success">
                            <tr>
                                <th style="width: 70px;">#</th>
                                <th>Member</th>
                                <th>Card Number</th>
                                <th>Phone</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var number = 1;
                            }
                            @foreach (var member in Model.MembersPresent)
                            {
                                <tr>
                                    <td>@number</td>
                                    <td class="fw-semibold">@member.Name</td>
                                    <td>@(string.IsNullOrWhiteSpace(member.CardNumber) ? "-" : member.CardNumber)</td>
                                    <td>@member.PhoneNumber</td>
                                </tr>
                                number++;
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-warning mb-0">
                    <i class="bi bi-info-circle"></i>
                    No members were marked Present for this Communion date.
                </div>
            }
        </div>
    </div>
</div>