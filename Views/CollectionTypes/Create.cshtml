@model ChurchManagementMVC.Models.CollectionType

@{
    ViewData["Title"] = "Create Collection Type";
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-tags-fill me-2"></i>
                Create Collection Type
            </h2>

            <p class="text-muted mb-0">
                Add a new church collection type.
            </p>
        </div>

        <div>
            <a asp-action="Index"
               class="btn btn-outline-secondary rounded-3 px-4">

                <i class="bi bi-arrow-left me-2"></i>
                Back to Collection Types

            </a>
        </div>

    </div>

    <!-- Collection Type Form -->
    <div class="row justify-content-center">

        <div class="col-xl-6 col-lg-7 col-md-9">

            <div class="card shadow-sm border-0 rounded-4">

                <!-- Card Header -->
                <div class="card-header bg-white border-0 pt-4 px-4">

                    <div class="d-flex align-items-center">

                        <div class="bg-success bg-opacity-10
                            text-success rounded-circle
                            d-flex align-items-center
                            justify-content-center me-3"
                             style="width: 50px; height: 50px;">

                            <i class="bi bi-tags-fill fs-5"></i>

                        </div>

                        <div>

                            <h5 class="fw-bold mb-1">
                                Collection Type Information
                            </h5>

                            <p class="text-muted mb-0">
                                Enter the details for the new collection type.
                            </p>

                        </div>

                    </div>

                </div>

                <!-- Card Body -->
                <div class="card-body p-4">

                    <form asp-action="Create" method="post">

                        @Html.AntiForgeryToken()

                        <!-- Validation Summary -->
                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger border-0 rounded-3 mb-4">
                        </div>

                        <!-- Collection Type Name -->
                        <div class="mb-4">

                            <label asp-for="Name"
                                   class="form-label fw-semibold">

                                <i class="bi bi-tag-fill me-1"></i>
                                Collection Type

                            </label>

                            <input asp-for="Name"
                                   class="form-control form-control-lg rounded-3"
                                   placeholder="e.g. Tithe" />

                            <span asp-validation-for="Name"
                                  class="text-danger small">
                            </span>

                        </div>

                        <!-- Buttons -->
                        <div class="d-flex justify-content-end gap-2 mt-4">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary rounded-3 px-4">

                                <i class="bi bi-x-circle me-1"></i>
                                Cancel

                            </a>

                            <button type="submit"
                                    class="btn btn-success rounded-3 px-4 shadow-sm">

                                <i class="bi bi-check-circle-fill me-1"></i>
                                Save Collection Type

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}