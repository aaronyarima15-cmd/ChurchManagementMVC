@model List<ChurchManagementMVC.Models.CollectionType>

@{
    ViewData["Title"] = "Collection Types";
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-tags-fill me-2"></i>
                Collection Types
            </h2>

            <p class="text-muted mb-0">
                Manage church collection types.
            </p>
        </div>

        <div>
            <a asp-action="Create"
               class="btn btn-success rounded-3 px-4 shadow-sm">

                <i class="bi bi-plus-circle me-2"></i>
                New Collection Type

            </a>
        </div>

    </div>

    <!-- Collection Types Card -->
    <div class="card shadow-sm border-0 rounded-4">

        <!-- Card Header -->
        <div class="card-header bg-white border-0 pt-4 px-4">

            <div class="d-flex align-items-center">

                <div class="bg-success bg-opacity-10
                    text-success rounded-circle
                    d-flex align-items-center
                    justify-content-center me-3"
                     style="width: 50px; height: 50px;">

                    <i class="bi bi-tags-fill fs-5"></i>

                </div>

                <div>

                    <h5 class="fw-bold mb-1">
                        Collection Type Records
                    </h5>

                    <p class="text-muted mb-0">
                        View and manage available collection types.
                    </p>

                </div>

            </div>

        </div>

        <!-- Table -->
        <div class="card-body p-0">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="ps-4">
                                    ID
                                </th>

                                <th>
                                    Collection Type
                                </th>

                                <th class="text-end pe-4">
                                    Actions
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var type in Model)
                            {
                                <tr>

                                    <!-- ID -->
                                    <td class="ps-4 fw-semibold">
                                        @type.Id
                                    </td>

                                    <!-- Collection Type -->
                                    <td>

                                        <div class="d-flex align-items-center">

                                            <div class="bg-success bg-opacity-10
                                                text-success rounded-circle
                                                d-flex align-items-center
                                                justify-content-center me-3"
                                                 style="width: 38px; height: 38px;">

                                                <i class="bi bi-tag-fill"></i>

                                            </div>

                                            <span class="fw-semibold">
                                                @type.Name
                                            </span>

                                        </div>

                                    </td>

                                    <!-- Actions -->
                                    <td class="text-end pe-4">

                                        <div class="d-flex justify-content-end gap-2">

                                            <!-- Edit -->
                                            <a asp-action="Edit"
                                               asp-route-id="@type.Id"
                                               class="btn btn-sm btn-outline-success rounded-3 px-3">

                                                <i class="bi bi-pencil-square me-1"></i>
                                                Edit

                                            </a>

                                            <!-- Delete -->
                                            <form asp-action="Delete"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@type.Id" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger rounded-3 px-3"
                                                        onclick="return confirm('Are you sure you want to delete this collection type?');">

                                                    <i class="bi bi-trash me-1"></i>
                                                    Delete

                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <!-- Empty State -->
                <div class="text-center py-5">

                    <div class="text-muted">

                        <i class="bi bi-tags fs-1 d-block mb-3"></i>

                        <h5 class="fw-semibold">
                            No Collection Types Found
                        </h5>

                        <p class="mb-3">
                            No collection types have been added yet.
                        </p>

                        <a asp-action="Create"
                           class="btn btn-success rounded-3 px-4">

                            <i class="bi bi-plus-circle me-2"></i>
                            Add First Collection Type

                        </a>

                    </div>

                </div>
            }

        </div>

    </div>

</div>