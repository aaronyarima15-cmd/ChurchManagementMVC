<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Church Management</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/ChurchManagementMVC.styles.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>

            body {
                font-size: 0.92rem;
                background-color: #f5f7f6;
                margin: 0;
                color: #212529;
                overflow-x: hidden;
            }

            a {
                text-decoration: none;
            }

            header {
                background-color: #ffffff;
                border-bottom: 1px solid #e5e7eb;
                box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
                min-height: 64px;
                position: relative;
                z-index: 1030;
            }

            .navbar-brand {
                font-size: 1.15rem;
                font-weight: 700;
                color: #0d6efd !important;
            }

                .navbar-brand i {
                    font-size: 1.2rem;
                }

            .user-info {
                font-size: 0.9rem;
            }

                .user-info span {
                    font-weight: 500;
                    color: #495057;
                }

            .user-avatar {
                width: 36px;
                height: 36px;
                border-radius: 50%;
                background-color: rgba(13, 110, 253, 0.1);
                color: #0d6efd;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .sidebar {
                width: 235px;
                height: calc(100vh - 64px);
                position: fixed;
                top: 64px;
                left: -235px;
                background-color: #ffffff;
                border-right: 1px solid #e5e7eb;
                padding: 1rem 0.85rem;
                overflow-y: auto;
                overflow-x: hidden;
                z-index: 1025;
                transition: left 0.25s ease-in-out;
                box-shadow: 4px 0 15px rgba(0, 0, 0, 0.06);
            }
                .sidebar.sidebar-open {
                    left: 0;
                }

                .sidebar .nav-link {
                    color: #495057;
                    font-size: 0.9rem;
                    font-weight: 500;
                    padding: 0.68rem 0.8rem;
                    margin-bottom: 0.25rem;
                    border-radius: 10px;
                    transition: all 0.2s ease-in-out;
                    display: flex;
                    align-items: center;
                }

                    .sidebar .nav-link i {
                        margin-right: 9px;
                        font-size: 1rem;
                        width: 20px;
                        text-align: center;
                    }

                    .sidebar .nav-link:hover {
                        background-color: rgba(13, 110, 253, 0.08);
                        color: #0d6efd;
                    }

                    .sidebar .nav-link.active {
                        background-color: rgba(13, 110, 253, 0.1);
                        color: #0d6efd;
                        font-weight: 600;
                    }

            .sidebar-edge-trigger {
                position: fixed;
                left: 0;
                top: 64px;
                width: 12px;
                height: calc(100vh - 64px);
                z-index: 1026;
                background: transparent;
            }

            .sidebar-section-title {
                font-size: 0.7rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.05rem;
                color: #9ca3af;
                padding: 0.8rem 0.8rem 0.45rem;
            }

            .collections-toggle {
                cursor: pointer;
            }

            .collections-arrow {
                margin-left: auto !important;
                margin-right: 0 !important;
                transition: transform 0.2s ease;
                width: auto !important;
            }

            .collections-toggle[aria-expanded="true"] .collections-arrow {
                transform: rotate(180deg);
            }

            .sidebar .submenu {
                padding-left: 0.65rem;
                margin-top: 0.15rem;
                margin-bottom: 0.35rem;
            }

                .sidebar .submenu .nav-link {
                    font-size: 0.85rem;
                    padding: 0.55rem 0.7rem;
                }

                    .sidebar .submenu .nav-link i {
                        font-size: 0.9rem;
                    }

            .main-content {
                padding: 0;
                min-width: 0;
                width: 100%;
                background-color: #f5f7f6;
            }

            main {
                background-color: transparent;
                border-radius: 0;
                padding: 0;
                box-shadow: none;
                min-height: calc(100vh - 120px);
            }

            .card {
                border-radius: 1rem;
            }

            h1 {
                font-size: 1.7rem;
            }

            h2 {
                font-size: 1.45rem;
            }

            h3 {
                font-size: 1.25rem;
            }

            h4 {
                font-size: 1.1rem;
            }

            .btn {
                font-size: 0.88rem;
            }

            .btn-sm {
                font-size: 0.8rem;
            }

            .btn-success {
                box-shadow: none;
            }

            .form-control,
            .form-select {
                font-size: 0.9rem;
            }

            .form-label {
                font-size: 0.9rem;
            }

            .table {
                font-size: 0.88rem;
            }

                .table th {
                    font-weight: 600;
                    white-space: nowrap;
                    color: #495057;
                }

                .table td {
                    vertical-align: middle;
                }

                .table > :not(caption) > * > * {
                    padding-top: 0.85rem;
                    padding-bottom: 0.85rem;
                }

            .alert {
                font-size: 0.9rem;
            }

            footer {
                font-size: 0.8rem;
                color: #6c757d;
                background-color: transparent;
            }

            .badge {
                font-weight: 500;
            }

            .holy-communion-icon {
                width: 20px;
                height: 20px;
                margin-right: 9px;
                flex-shrink: 0;
                fill: currentColor;
            }

            @@media (max-width: 992px) {

                .sidebar {
                    width: 210px;
                    left: -210px;
                }

                    .sidebar.sidebar-open {
                        left: 0;
                    }
            }

            @@media (max-width: 768px) {

                header {
                    min-height: 58px;
                }

                .sidebar {
                    top: 58px;
                    width: 180px;
                    height: calc(100vh - 58px);
                    left: -180px;
                    padding: 0.65rem 0.5rem;
                }

                    .sidebar.sidebar-open {
                        left: 0;
                    }

                .sidebar-edge-trigger {
                    top: 58px;
                    height: calc(100vh - 58px);
                }

                .sidebar .nav-link {
                    font-size: 0.82rem;
                    padding: 0.55rem 0.55rem;
                }

                    .sidebar .nav-link i {
                        font-size: 0.9rem;
                        margin-right: 6px;
                    }

                .holy-communion-icon {
                    width: 18px;
                    height: 18px;
                    margin-right: 6px;
                }

                .user-info span {
                    display: none;
                }

                .navbar-brand {
                    font-size: 1rem;
                }
            }

            @@media (max-width: 576px) {

                .sidebar {
                    width: 180px;
                    left: -180px;
                    padding: 0.65rem 0.5rem;
                }

                    .sidebar.sidebar-open {
                        left: 0;
                    }

                    .sidebar .nav-link {
                        justify-content: flex-start;
                        padding: 0.65rem 0.55rem;
                        font-size: 0.82rem;
                    }

                        .sidebar .nav-link i {
                            margin-right: 7px;
                            font-size: 1rem;
                        }

                        .sidebar .nav-link span {
                            display: inline;
                        }

                .holy-communion-icon {
                    width: 20px;
                    height: 20px;
                    margin-right: 7px;
                }

                .sidebar-section-title {
                    display: block;
                }

                .collections-arrow {
                    display: block;
                }

                .sidebar .submenu {
                    padding-left: 0.65rem;
                }
            }

    </style>
</head>

<body>

    <header class="navbar navbar-light px-3">

        <div class="container-fluid d-flex justify-content-between align-items-center">

            <!-- Church Management Logo -->

            <a class="navbar-brand d-flex align-items-center"
               asp-controller="Home"
               asp-action="Dashboard">

                <i class="bi bi-building-fill me-2"></i>

                Church Management

            </a>


            <!-- User Information -->

            <div class="user-info d-flex align-items-center gap-3">

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="d-flex align-items-center gap-2">

                        <div class="user-avatar">
                            <i class="bi bi-person-fill"></i>
                        </div>

                        <span>
                            Hello, @User.Identity.Name
                        </span>

                    </div>


                    <!-- Logout -->

                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post"
                          class="d-inline">

                        <button type="submit"
                                class="btn btn-outline-danger btn-sm rounded-3 px-3">

                            <i class="bi bi-box-arrow-right me-1"></i>

                            Logout

                        </button>

                    </form>
                }
                else
                {
                    <!-- Login -->

                    <a asp-controller="Account"
                       asp-action="Login"
                       class="btn btn-primary btn-sm rounded-3 px-3">

                        <i class="bi bi-box-arrow-in-right me-1"></i>

                        Login

                    </a>
                }

            </div>

        </div>

    </header>


    <!-- =========================================================
         SIDEBAR EDGE TRIGGER

         Move the mouse to the far left side of the screen
         to open the sidebar.
    ========================================================== -->

    <div class="sidebar-edge-trigger"
         id="sidebarEdgeTrigger">
    </div>


    <!-- =========================================================
         PAGE BODY
    ========================================================== -->

    <div class="d-flex">


        <!-- =====================================================
             SIDEBAR
        ====================================================== -->

        <nav class="sidebar"
             id="mainSidebar">

            @if (User.Identity?.IsAuthenticated == true)
            {
                <ul class="nav flex-column">


                    <!-- DASHBOARD -->

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Dashboard">

                            <i class="bi bi-speedometer2"></i>

                            <span>Dashboard</span>

                        </a>

                    </li>


                    <!-- =================================================
                         MEMBER
                    ================================================== -->
                    @if (User.IsInRole("Member"))
                    {
                        <li class="sidebar-section-title">
                            Member
                        </li>


                        <!-- My Profile -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="MemberProfile"
                               asp-action="Index">

                                <i class="bi bi-person-circle"></i>

                                <span>My Profile</span>

                            </a>

                        </li>
                    }


                    <!-- =================================================
                         ADMIN / PASTOR / SECRETARY
                    ================================================== -->
                    @if (
                                            User.IsInRole("Admin") ||
                                            User.IsInRole("Pastor") ||
                                            User.IsInRole("Secretary")
                                        )
                    {
                        <li class="sidebar-section-title">
                            Church Management
                        </li>


                        <!-- MEMBERS -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Members"
                               asp-action="Index">

                                <i class="bi bi-people-fill"></i>

                                <span>Members</span>

                            </a>

                        </li>


                        <!-- GROUPS -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Groups"
                               asp-action="Index">

                                <i class="bi bi-diagram-3"></i>

                                <span>Groups</span>

                            </a>

                        </li>


                        <!-- GROUP TYPES -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="GroupTypes"
                               asp-action="Index">

                                <i class="bi bi-diagram-3"></i>

                                <span>Group Types</span>

                            </a>

                        </li>


                        <!-- EVENTS -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Events"
                               asp-action="Index">

                                <i class="bi bi-calendar-event"></i>

                                <span>Events</span>

                            </a>

                        </li>


                        <!-- ATTENDANCE -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Attendance"
                               asp-action="Index">

                                <i class="bi bi-clipboard-check"></i>

                                <span>Attendance</span>

                            </a>

                        </li>


                        <!-- HOLY COMMUNION -->

                        <li class="nav-item">

                            <!-- Holy Communion Parent Menu -->
                            <a class="nav-link d-flex align-items-center justify-content-between"
                               data-bs-toggle="collapse"
                               href="#holyCommunionMenu"
                               role="button"
                               aria-expanded="false"
                               aria-controls="holyCommunionMenu">

                                <span class="d-flex align-items-center">

                                    <!-- Bread and Communion Cup Icon -->
                                    <svg class="holy-communion-icon"
                                         xmlns="http://www.w3.org/2000/svg"
                                         viewBox="0 0 24 24"
                                         aria-hidden="true">

                                        <!-- Bread -->
                                        <path d="M7 4.5C7 3.12 8.12 2 9.5 2h5C15.88 2 17 3.12 17 4.5c0 .78-.36 1.47-.92 1.92.57.47.92 1.17.92 1.95C17 9.82 15.88 11 14.5 11h-5C8.12 11 7 9.82 7 8.37c0-.78.35-1.48.92-1.95A2.48 2.48 0 0 1 7 4.5Z" />

                                        <!-- Cup -->
                                        <path d="M5 12h14v2c0 3.06-2.07 5.63-4.88 6.39L13.5 22h-3l-.62-1.61A6.67 6.67 0 0 1 5 14v-2Zm2 2c0 2.04 1.57 3.73 3.56 3.96L11 18h2l.44-.04C15.43 17.73 17 16.04 17 14H7Z" />

                                    </svg>

                                    <span>Holy Communion</span>

                                </span>

                                <i class="bi bi-chevron-down small"></i>

                            </a>


                            <!-- Holy Communion Submenu -->
                            <div class="collapse"
                                 id="holyCommunionMenu">

                                <ul class="nav flex-column ms-3">

                                    <!-- Communion Attendance -->
                                    <li class="nav-item">

                                        <a class="nav-link"
                                           asp-controller="Communion"
                                           asp-action="Index">

                                            <i class="bi bi-check2-square me-2"></i>

                                            Communion Attendance

                                        </a>

                                    </li>


                                    <!-- Communion Report -->
                                    <li class="nav-item">

                                        <a class="nav-link"
                                           asp-controller="Communion"
                                           asp-action="Report">

                                            <i class="bi bi-bar-chart-line me-2"></i>

                                            Communion Report

                                        </a>

                                    </li>

                                </ul>

                            </div>

                        </li>


                        <!-- CHURCH COMMITTEE -->

                        <li class="nav-item">

                            <a class="nav-link d-flex justify-content-between align-items-center"
                               data-bs-toggle="collapse"
                               href="#churchCommitteeMenu"
                               role="button"
                               aria-expanded="false"
                               aria-controls="churchCommitteeMenu">

                                <span>

                                    <i class="bi bi-person-badge"></i>

                                    <span>Church Committee</span>

                                </span>

                                <i class="bi bi-chevron-down collections-arrow"></i>

                            </a>


                            <div class="collapse"
                                 id="churchCommitteeMenu">

                                <ul class="nav flex-column submenu">


                                    <!-- Committee Officials -->

                                    <li class="nav-item">

                                        <a class="nav-link"
                                           asp-controller="ChurchCommittee"
                                           asp-action="Index">

                                            <i class="bi bi-people"></i>

                                            <span>Committee Officials</span>

                                        </a>

                                    </li>


                                    <!-- Positions -->

                                    <li class="nav-item">

                                        <a class="nav-link"
                                           asp-controller="Position"
                                           asp-action="Index">

                                            <i class="bi bi-award"></i>

                                            <span>Positions</span>

                                        </a>

                                    </li>

                                </ul>

                            </div>

                        </li>
                    }


                    <!-- =================================================
                         ADMIN / TREASURER
                         FINANCIAL MANAGEMENT
                    ================================================== -->
                    @if (
                                            User.IsInRole("Admin") ||
                                            User.IsInRole("Treasurer")
                                        )
                    {
                        <li class="sidebar-section-title">
                            Financial Management
                        </li>


                        <!-- FINANCE -->

                        <li class="nav-item">

                            <a class="nav-link collections-toggle d-flex align-items-center"
                               data-bs-toggle="collapse"
                               href="#collectionsMenu"
                               role="button"
                               aria-expanded="false"
                               aria-controls="collectionsMenu">

                                <span>

                                    <i class="bi bi-cash-stack"></i>

                                    <span>Finance</span>

                                </span>

                                <i class="bi bi-chevron-down collections-arrow"></i>

                            </a>


                            <!-- Finance Submenu -->

                            <div class="collapse"
                                 id="collectionsMenu">

                                <ul class="nav flex-column submenu">


                                    <!-- Collections -->

                                    <li class="nav-item">

                                        <a class="nav-link"
                                           asp-controller="Collections"
                                           asp-action="Index">

                                            <i class="bi bi-arrow-down-circle"></i>

                                            <span>Collections</span>

                                        </a>

                                    </li>


                                    <!-- Expenditures -->

                                    <li class="nav-item">

                                        <a class="nav-link"
                                           asp-controller="Expenditures"
                                           asp-action="Index">

                                            <i class="bi bi-arrow-up-circle"></i>

                                            <span>Expenditures</span>

                                        </a>

                                    </li>


                                    <!-- Reports -->

                                    <li class="nav-item">

                                        <a class="nav-link"
                                           asp-controller="Reports"
                                           asp-action="Index">

                                            <i class="bi bi-bar-chart-line"></i>

                                            <span>Reports</span>

                                        </a>

                                    </li>

                                </ul>

                            </div>

                        </li>


                        <!-- COLLECTION TYPES -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="CollectionTypes"
                               asp-action="Index">

                                <i class="bi bi-tags"></i>

                                <span>Collection Types</span>

                            </a>

                        </li>


                        <!-- PAYMENT METHODS -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="PaymentMethods"
                               asp-action="Index">

                                <i class="bi bi-credit-card"></i>

                                <span>Payment Methods</span>

                            </a>

                        </li>


                        <!-- EXPENDITURE TYPES -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="ExpenditureTypes"
                               asp-action="Index">

                                <i class="bi bi-tags"></i>

                                <span>Expenditure Types</span>

                            </a>

                        </li>

                    }


                    <!-- =================================================
                         ADMIN ONLY
                    ================================================== -->
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="sidebar-section-title">
                            Administration
                        </li>


                        <!-- USER MANAGEMENT -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Admin"
                               asp-action="Users">

                                <i class="bi bi-person-gear"></i>

                                <span>User Management</span>

                            </a>

                        </li>
                    }

                </ul>
            }

        </nav>


        <!-- =========================================================
             MAIN CONTENT
        ========================================================== -->

        <div class="flex-grow-1 main-content">

            <main role="main">

                @RenderBody()

            </main>


            <!-- =====================================================
                 FOOTER
            ====================================================== -->

            <footer class="border-top text-muted mt-3 pt-3 pb-3">

                <div class="container-fluid px-4">

                    &copy; @DateTime.Now.Year - Church Management System

                </div>

            </footer>

        </div>

    </div>


    <!-- =========================================================
         JAVASCRIPT
    ========================================================== -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>


    <!-- =========================================================
         HOVER SIDEBAR SCRIPT
    ========================================================== -->

    <script>

            document.addEventListener("DOMContentLoaded", function() {

                const sidebar =
                    document.getElementById("mainSidebar");

                const edgeTrigger =
                    document.getElementById("sidebarEdgeTrigger");

                if (!sidebar || !edgeTrigger) {
                    return;
                }


                /*
                    Open sidebar when mouse reaches
                    the far left edge.
                */

                edgeTrigger.addEventListener("mouseenter", function() {

                    sidebar.classList.add("sidebar-open");

                });


                /*
                    Keep sidebar open while the mouse
                    is inside the sidebar.
                */

                sidebar.addEventListener("mouseenter", function() {

                    sidebar.classList.add("sidebar-open");

                });


                /*
                    Close sidebar when the mouse
                    leaves the sidebar.
                */

                sidebar.addEventListener("mouseleave", function() {

                    sidebar.classList.remove("sidebar-open");

                });

            });

    </script>


    @await RenderSectionAsync(
        "Scripts",
        required: false
    )

</body>
</html>
