@model ErrorViewModel

@{
    ViewData["Title"] = "Error";
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-exclamation-triangle-fill text-danger me-2"></i>
                Something Went Wrong
            </h2>

            <p class="text-muted mb-0">
                An unexpected error occurred while processing your request.
            </p>
        </div>

        <a asp-controller="Home"
           asp-action="Dashboard"
           class="btn btn-outline-secondary rounded-3 px-4">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Dashboard

        </a>
    </div>


    <!-- Error Card -->
    <div class="row justify-content-center">

        <div class="col-xl-8 col-lg-9 col-md-10">

            <div class="card shadow-sm border-0 rounded-4">

                <!-- Card Header -->
                <div class="card-header bg-white border-0 pt-4 px-4">

                    <div class="d-flex align-items-center">

                        <div class="bg-danger bg-opacity-10 text-danger rounded-circle
                            d-flex align-items-center justify-content-center me-3"
                             style="width: 50px; height: 50px;">

                            <i class="bi bi-exclamation-triangle-fill fs-4"></i>

                        </div>

                        <div>
                            <h5 class="fw-bold mb-1">
                                Error Details
                            </h5>

                            <p class="text-muted mb-0">
                                The application could not complete your request.
                            </p>
                        </div>

                    </div>

                </div>


                <!-- Card Body -->
                <div class="card-body p-4">

                    <!-- Error Message -->
                    <div class="alert alert-danger border-0 rounded-3 mb-4">

                        <div class="d-flex">

                            <i class="bi bi-x-circle-fill me-2 mt-1"></i>

                            <div>
                                <strong>An error occurred while processing your request.</strong>

                                <p class="mb-0 small mt-1">
                                    Please try again. If the problem continues,
                                    contact the system administrator.
                                </p>
                            </div>

                        </div>

                    </div>


                    <!-- Request ID -->
                    @if (Model.ShowRequestId)
                    {
                        <div class="bg-light rounded-3 p-3 mb-4">

                            <div class="d-flex align-items-center">

                                <div class="bg-secondary bg-opacity-10 text-secondary
                                    rounded-circle d-flex align-items-center
                                    justify-content-center me-3"
                                     style="width: 42px; height: 42px;">

                                    <i class="bi bi-hash"></i>

                                </div>

                                <div>

                                    <div class="text-muted small">
                                        Request ID
                                    </div>

                                    <code class="fw-semibold">
                                        @Model.RequestId
                                    </code>

                                </div>

                            </div>

                        </div>
                    }


                    <!-- Development Information -->
                    <div class="card border-0 bg-light rounded-4">

                        <div class="card-body p-4">

                            <h6 class="fw-bold mb-3">

                                <i class="bi bi-code-slash text-success me-2"></i>

                                Development Information

                            </h6>

                            <p class="text-muted mb-3">
                                When running the application locally in the
                                <strong>Development</strong> environment,
                                ASP.NET Core can display more detailed information
                                about the error.
                            </p>

                            <div class="alert alert-warning border-0 rounded-3 mb-0">

                                <div class="d-flex">

                                    <i class="bi bi-shield-exclamation me-2 mt-1"></i>

                                    <div>

                                        <strong>Security Notice</strong>

                                        <p class="mb-0 small mt-1">
                                            The Development environment should not
                                            be enabled on deployed applications because
                                            detailed exception information may contain
                                            sensitive data.
                                        </p>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- Actions -->
                    <div class="d-flex justify-content-end gap-2 mt-4">

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="btn btn-outline-secondary rounded-3 px-4">

                            <i class="bi bi-house me-1"></i>
                            Home

                        </a>

                        <a asp-controller="Home"
                           asp-action="Dashboard"
                           class="btn btn-success rounded-3 px-4 shadow-sm">

                            <i class="bi bi-speedometer2 me-1"></i>
                            Dashboard

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>