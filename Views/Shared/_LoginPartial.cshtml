@using Microsoft.AspNetCore.Identity
@using ChurchManagementMVC.Models
@inject SignInManager<Admins> SignInManager

<ul class="navbar-nav ms-auto align-items-center">

    @if (SignInManager.IsSignedIn(User))
    {
        <!-- Logged-in User -->

        <li class="nav-item me-2">

            <span class="nav-link d-flex align-items-center text-dark">

                <span class="d-inline-flex align-items-center justify-content-center
                    bg-success bg-opacity-10 text-success rounded-circle me-2"
                      style="width: 34px; height: 34px;">

                    <i class="bi bi-person-fill"></i>

                </span>

                <span class="fw-semibold">
                    Hello, @User.Identity?.Name
                </span>

            </span>

        </li>


        <!-- Logout -->

        <li class="nav-item">

            <form asp-controller="Account"
                  asp-action="Logout"
                  method="post"
                  class="d-inline">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-outline-danger btn-sm rounded-3 px-3">

                    <i class="bi bi-box-arrow-right me-1"></i>

                    Logout

                </button>

            </form>

        </li>
    }
    else
    {
        <!-- Login -->

        <li class="nav-item me-2">

            <a class="btn btn-success btn-sm rounded-3 px-3"
               asp-controller="Account"
               asp-action="Login">

                <i class="bi bi-box-arrow-in-right me-1"></i>

                Login

            </a>

        </li>


        <!-- Register -->

        <li class="nav-item">

            <a class="btn btn-outline-success btn-sm rounded-3 px-3"
               asp-controller="Account"
               asp-action="Register">

                <i class="bi bi-person-plus me-1"></i>

                Register

            </a>

        </li>
    }

</ul>